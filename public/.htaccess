# ─────────────────────────────────────────────────────────────
#  BookGo — configuração do Apache (cPanel)
#  Este arquivo é copiado de public/ para dist/ pelo build e
#  enviado ao document root no deploy.
# ─────────────────────────────────────────────────────────────

Options -Indexes

# Página 404 gerada pelo Astro (build.format = 'directory')
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Domínio canônico: https://bookgo.com.br (sem www).
  # ATENÇÃO: só mantenha o bloco de HTTPS depois que o certificado SSL
  # estiver ativo no cPanel (AutoSSL). Antes disso, comente as duas linhas.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # /sitemap.xml nunca existiu: o @astrojs/sitemap gera sitemap-index.xml
  # (o índice) e sitemap-0.xml (as URLs). O robots.txt aponta para o índice,
  # que é o endereço correto. Mas /sitemap.xml é o palpite de quem digita
  # à mão e de parte das ferramentas, e devolvia 404. O redirecionamento
  # resolve isso sem renomear arquivo já conhecido pelo Search Console.
  RewriteRule ^sitemap\.xml$ /sitemap-index.xml [L,R=301]
</IfModule>

# ── Compressão ───────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Cache ────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Assets com hash no nome: imutáveis.
  <FilesMatch "\.(js|css|woff2|avif|webp|png|jpe?g|svg|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML sempre revalidado, para que uma publicação apareça na hora.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

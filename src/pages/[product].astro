---
import ProductLayout from '../layouts/ProductLayout.astro';
import Section from '../components/ui/Section.astro';
import Cta from '../components/ui/Cta.astro';
import Hero from '../components/product/Hero.astro';
import BulletList from '../components/product/BulletList.astro';
import CardGrid from '../components/product/CardGrid.astro';
import StepList from '../components/product/StepList.astro';
import ModuleList from '../components/product/ModuleList.astro';
import OfferBox from '../components/product/OfferBox.astro';
import Faq from '../components/product/Faq.astro';
import PlayfulBackdrop from '../components/product/PlayfulBackdrop.astro';
import ColoringPagesArt from '../components/product/ColoringPagesArt.astro';
import ReviewsSection from '../components/reviews/ReviewsSection.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import ProductImage from '../components/product/ProductImage.astro';
import MaterialGrid from '../components/product/MaterialGrid.astro';
import ThemeGrid from '../components/product/ThemeGrid.astro';
import { productImage, missingProductImages } from '../lib/product-images';
import TrackPageEvent from '../components/tracking/TrackPageEvent.astro';
import { eventAttrs } from '../lib/tracking';
import {
  getProducts,
  hasCheckout,
  productUrl,
  type Product,
} from '../lib/content';
import * as schema from '../lib/schema';

export async function getStaticPaths() {
  /* Imagem declarada cujo arquivo ainda não chegou. Não é erro — é o que
     permite desenhar a página antes de a fotografia existir. Mas precisa
     aparecer no log, senão o slot silencioso passa despercebido. */
  const missing = await missingProductImages();
  if (missing.length > 0) {
    console.warn(
      `\n[imagens] ${missing.length} imagem(ns) de produto declarada(s) sem arquivo:`
    );
    for (const m of missing) {
      console.warn(`  · ${m.expectedPath}`);
      console.warn(`    ${m.role}`);
      console.warn(`    alt: ${m.alt}`);
    }
    console.warn('');
  }

  const products = await getProducts();

  return products.map((product) => {
    if (!hasCheckout(product)) {
      console.warn(
        `[bookgo] Checkout pendente para "${product.id}": o CTA será renderizado sem link.`
      );
    }
    return {
      params: { product: product.data.slug },
      props: { product },
    };
  });
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const d = product.data;
const path = productUrl(d.slug);
const checkoutHref = hasCheckout(product) ? d.checkout.url : null;
const heroImage = productImage(d.slug, d.hero.image);

/**
 * Clique no checkout. É intenção, não compra: nenhum `Purchase` sai daqui —
 * quem conhece a transação é a Kiwify. Ver docs/tracking.md.
 */
const checkoutEvent = eventAttrs('checkout_click', {
  product_slug: d.slug,
  product_name: d.name,
  value: d.price.amount,
  currency: d.price.currency,
});

/* Chamadas intermediárias, pelas âncoras declaradas no YAML. Levam à
   oferta, nunca ao checkout: ver o comentário na primeira delas. */
const midCtaAt = (after: string) => d.midCta.filter((c) => c.after === after);

/* Imagens editoriais, distribuídas pelas âncoras declaradas no YAML.
   Arquivo inexistente não renderiza nada — ver ProductImage.astro. */
/* Só entram as que têm arquivo. O componente já não renderiza a figura sem
   ele, mas o invólucro da seção continuava ocupando altura: uma faixa de
   ar entre duas seções, sem nada dentro. Filtrar aqui é o que faz a página
   fechar sozinha enquanto a fotografia não chega. */
const imagesAt = (placement: string) =>
  d.images.filter(
    (i) => i.placement === placement && productImage(d.slug, i.src)
  );

/* A foto que acompanha o mecanismo, quando declarada. Uma só: duas fotos ao
   lado do mesmo argumento competiriam entre si. */
const [methodImage] = imagesAt('beside-method');
const [benefitsImage] = imagesAt('beside-benefits');
const [useCasesImage] = imagesAt('beside-use-cases');

/* Rótulo do botão por posição.
   O destino e o evento são os mesmos nos três botões de compra: o que
   muda é a frase, que acompanha o que a pessoa acabou de ler. Repetir o
   mesmo texto em três lugares lê como formulário, e não como convite. */
const heroCta = d.hero.ctaLabel ?? d.checkout.cta;
const offerCta = d.offer.ctaLabel ?? d.checkout.cta;
const finalCtaLabel = d.finalCta.ctaLabel ?? d.checkout.cta;

const crumbs = [
  { name: 'Início', path: '/' },
  { name: d.name, path },
];
---

<ProductLayout
  title={d.seo.title}
  description={d.seo.description}
  ogImage={d.seo.ogImage}
  theme={d.theme}
  schema={[
    schema.organization(),
    schema.productSchema(product, path),
    schema.breadcrumbs(crumbs),
  ]}
>
  {/* Ambientação lúdica, só onde o YAML pede. Nenhuma LP existente muda
      por este bloco existir. */}
  {d.ambience === 'playful' && <PlayfulBackdrop />}

  <Hero
    eyebrow={d.hero.eyebrow}
    headline={d.hero.headline}
    subheadline={d.hero.subheadline}
    highlights={[...d.hero.highlights]}
    ctaLabel={heroCta}
    ctaHref={checkoutHref}
    price={d.price.display}
    image={heroImage}
    imageAlt={d.hero.imageAlt}
    track={checkoutEvent}
  >
    {/* Enquanto a foto do material não existir, a LP lúdica desenha a
        própria composição em vez de deixar o quadro vazio. */}
    {d.ambience === 'playful' && !heroImage && <ColoringPagesArt slot="art" />}
  </Hero>

  <TrackPageEvent
    event="product_view"
    params={{
      product_slug: d.slug,
      product_name: d.name,
      value: d.price.amount,
      currency: d.price.currency,
    }}
  />

  {/* Problema */}
  {/* Cabeçalho largo: a manchete da dor é longa e, na coluna estreita
      padrão, quebrava em sete linhas curtas que esticavam o lado esquerdo
      muito além dos bullets ao lado. */}
  <Section
    layout="split"
    headWidth="27rem"
    title={d.problem.title}
    intro={d.problem.intro}
  >
    <BulletList items={[...d.problem.items]} marker="dot" columns />
    {d.problem.close && <p class="close">{d.problem.close}</p>}
  </Section>

  {
    imagesAt('after-hero').map((img) => (
      <div class="container figure-wrap figure-tight">
        <ProductImage
          slug={d.slug}
          src={img.src}
          alt={img.alt}
          caption={img.caption}
          ratio={img.ratio}
        />
      </div>
    ))
  }

  {
    imagesAt('after-problem').map((img) => (
      <div class="container figure-wrap">
        <ProductImage
          slug={d.slug}
          src={img.src}
          alt={img.alt}
          caption={img.caption}
          ratio={img.ratio}
        />
      </div>
    ))
  }

  {/* Mecanismo */}
  {/* Cabeçalho central, como antes: o mecanismo do produto tem peso de
      manifesto e não de mais uma lista.

      O corpo muda quando existe a foto da âncora `beside-method`: ela vai a
      uma coluna e os pilares à outra, em vez de a foto ocupar largura
      sozinha entre duas seções. Uma imagem que ilustra o argumento ao lado
      dele vale mais do que a mesma imagem com uma legenda embaixo. Sem o
      arquivo, a seção volta sozinha à grade de dois pilares. */}
  <Section
    tone="warm"
    align="center"
    eyebrow={d.method.name}
    title={d.method.title}
    intro={d.method.intro}
  >
    {
      methodImage ? (
        <div class="method-split">
          <div class="method-figure">
            <ProductImage
              slug={d.slug}
              src={methodImage.src}
              alt={methodImage.alt}
              ratio="3 / 2"
            />
          </div>
          <CardGrid items={[...d.method.pillars]} cols={1} min="100%" />
        </div>
      ) : (
        <CardGrid items={[...d.method.pillars]} min="16rem" />
      )
    }
    {d.method.note && <p class="note note-center">{d.method.note}</p>}
  </Section>

  {
    imagesAt('after-method').map((img) => (
      <div class="container figure-wrap">
        <ProductImage
          slug={d.slug}
          src={img.src}
          alt={img.alt}
          caption={img.caption}
          ratio={img.ratio}
        />
      </div>
    ))
  }

  {/* Benefícios.

      O primeiro cartão só ocupa duas colunas quando isso fecha a grade.
      Com `feature`, a contagem efetiva de células é `itens + 1`, e a
      última linha só fica cheia numa grade de três quando esse total é
      múltiplo de três. Cinco benefícios fecham; seis, não, e o destaque
      sai sozinho para a grade não terminar num órfão. */}
  <Section title={d.benefits.title} intro={d.benefits.intro}>
    {
      benefitsImage ? (
        <div class="side-split side-split-reverse">
          <CardGrid items={[...d.benefits.items]} cols={2} min="14rem" />
          <div class="side-figure">
            <ProductImage
              slug={d.slug}
              src={benefitsImage.src}
              alt={benefitsImage.alt}
              caption={benefitsImage.caption}
              ratio={benefitsImage.ratio ?? '3 / 4'}
            />
          </div>
        </div>
      ) : (
        <CardGrid
          items={[...d.benefits.items]}
          cols={3}
          feature={(d.benefits.items.length + 1) % 3 === 0}
        />
      )
    }
  </Section>

  {/* Como funciona */}
  {/* Jornada horizontal no desktop, empilhada no mobile. Os números deixam
      de ser marcador e passam a ser a estrutura da composição. */}
  <Section
    tone="warm"
    align="center"
    title={d.howItWorks.title}
    intro={d.howItWorks.intro}
  >
    <StepList steps={[...d.howItWorks.steps]} />
  </Section>

  {
    imagesAt('after-how-it-works').map((img) => (
      <div class="container figure-wrap">
        <ProductImage
          slug={d.slug}
          src={img.src}
          alt={img.alt}
          caption={img.caption}
          ratio={img.ratio}
        />
      </div>
    ))
  }

  {/* CTA de continuidade.

      A LP tem dois tipos de botão, e a diferença não é de estilo:

      · de compra  — leva ao checkout e carrega `checkout_click`. São o do
                     hero, o da oferta e o do fechamento, todos ao lado do
                     preço ou depois dele;
      · de continuidade — leva à oferta, na própria página. Não carrega
                     evento de compra, porque rolar a página não é intenção
                     de pagamento e contá-la como tal misturaria dois
                     momentos do funil no mesmo número.

      Quem chega aqui ainda não viu preço nem o que está incluído, e mandar
      direto ao pagamento cobraria a decisão antes de a pessoa ter com o que
      decidir. É a mesma regra que vale do artigo para a LP, aplicada dentro
      da página. */}
  {
    midCtaAt('how-it-works').map((c) => (
      <div class="container midcta">
        <p>{c.text}</p>
        <Cta href="#oferta" label={c.label ?? d.checkout.cta} kind="continue" />
      </div>
    ))
  }

  {/* Os temas do material.

      Curso usa a lista numerada, porque ali a ordem é o produto: o módulo
      2 depende do 1. Uma coleção para colorir não tem ordem nenhuma, e a
      grade é o que mostra variedade, que é o argumento desta seção. A
      escolha sai do próprio conteúdo: quem declara ícone nos temas quer a
      vitrine; quem não declara continua na lista de módulos, e nenhuma LP
      existente muda por este bloco existir. */}
  <Section
    layout={d.contents.modules.some((m) => m.icon) ? undefined : 'split'}
    align={d.contents.modules.some((m) => m.icon) ? 'center' : undefined}
    title={d.contents.title}
    intro={d.contents.intro}
  >
    {
      d.contents.modules.some((m) => m.icon) ? (
        <ThemeGrid
          items={d.contents.modules.map((m) => ({ ...m }))}
          countLabel={d.contents.countLabel}
        />
      ) : (
        <ModuleList modules={[...d.contents.modules]} />
      )
    }
  </Section>

  {
    imagesAt('after-contents').map((img) => (
      <div class="container figure-wrap">
        <ProductImage
          slug={d.slug}
          src={img.src}
          alt={img.alt}
          caption={img.caption}
          ratio={img.ratio}
        />
      </div>
    ))
  }

  {/* Materiais incluídos */}
  <Section
    tone="warm"
    align="center"
    title={d.materials.title}
    intro={d.materials.intro}
  >
    <MaterialGrid slug={d.slug} items={[...d.materials.items]} />
  </Section>

  {
    imagesAt('after-materials').map((img) => (
      <div class="container figure-wrap">
        <ProductImage
          slug={d.slug}
          src={img.src}
          alt={img.alt}
          caption={img.caption}
          ratio={img.ratio}
        />
      </div>
    ))
  }

  {
    midCtaAt('materials').map((c) => (
      <div class="container midcta">
        <p>{c.text}</p>
        <Cta href="#oferta" label={c.label ?? d.checkout.cta} kind="continue" />
      </div>
    ))
  }

  {/* Situações de uso.

      Benefício responde "o que isso me dá"; situação responde "quando eu
      vou usar". Quem compra material para criança costuma decidir na
      segunda pergunta: a tarde de chuva e a sala de espera são
      reconhecidas na hora, e um benefício abstrato não é.

      Só existe quando o YAML traz o bloco. Sem ele, nenhuma LP muda. */}
  {
    d.useCases && (
      <Section
        tone="warm"
        title={d.useCases.title}
        intro={d.useCases.intro}
        align={useCasesImage ? undefined : 'center'}
      >
        {useCasesImage ? (
          <div class="side-split">
            <div class="side-figure">
              <ProductImage
                slug={d.slug}
                src={useCasesImage.src}
                alt={useCasesImage.alt}
                caption={useCasesImage.caption}
                ratio={useCasesImage.ratio ?? '3 / 4'}
              />
            </div>
            <CardGrid items={[...d.useCases.items]} cols={2} min="13rem" />
          </div>
        ) : (
          <CardGrid items={[...d.useCases.items]} cols={4} min="13rem" />
        )}
      </Section>
    )
  }

  {/* Público */}
  <Section title={d.audience.title} intro={d.audience.intro} align="center">
    <div class="audience">
      <div class="aud yes">
        <h3>{d.forWho.title}</h3>
        <BulletList items={[...d.forWho.items]} marker="check" badge />
      </div>
      <div class="aud no">
        <h3>{d.notForWho.title}</h3>
        <BulletList items={[...d.notForWho.items]} marker="x" badge />
      </div>
    </div>
  </Section>

  {/* Avaliações. Cada uma é uma conversa dentro de um celular, e o
      carrossel move os aparelhos. Não renderiza nada sem itens, e quantos
      cabem por vez sai da largura da tela limitada pela quantidade: a LP
      não escolhe nem conhece esse número.

      Fica entre "para quem é" e a oferta: a pessoa acabou de se
      reconhecer no público, ainda não viu o preço, e é exatamente aí que
      pesa o que outra pessoa tem a dizer. */}
  {
    imagesAt('before-reviews').map((img) => (
      <div class="container figure-wrap">
        <ProductImage
          slug={d.slug}
          src={img.src}
          alt={img.alt}
          caption={img.caption}
          ratio={img.ratio}
        />
      </div>
    ))
  }

  <ReviewsSection
    enabled={d.reviews.enabled}
    title={d.reviews.title}
    subtitle={d.reviews.subtitle}
    items={d.reviews.items.map((i) => ({ ...i, messages: [...i.messages] }))}
  />

  {
    imagesAt('before-offer').map((img) => (
      <div class="container figure-wrap">
        <ProductImage
          slug={d.slug}
          src={img.src}
          alt={img.alt}
          caption={img.caption}
          ratio={img.ratio}
        />
      </div>
    ))
  }

  {/* Oferta */}
  <Section
    id="oferta"
    tone="soft"
    title={d.offer.title}
    intro={d.offer.intro}
    align="center"
  >
    {/* A garantia entra aqui dentro, e não numa faixa própria logo
        abaixo: ela é parte da oferta. No celular a leitura fica título,
        conteúdo incluído, preço, botão, reasseguranças e garantia, numa
        sequência só, sem uma seção nova cortando a decisão no meio. */}
    <OfferBox
      heading={d.offer.includesTitle}
      highlights={[...d.offer.highlights]}
      groups={d.offer.groups.map((g) => ({ ...g, items: [...g.items] }))}
      includes={[...d.offer.includes]}
      price={d.price.display}
      priceTerms={d.offer.priceTerms}
      priceNote={d.offer.priceNote}
      ctaLabel={offerCta}
      ctaHref={checkoutHref}
      reassurances={[...(d.offer.reassurances ?? [])]}
      guarantee={
        d.guarantee && {
          title: d.guarantee.title,
          text: d.guarantee.text,
          icon: d.guarantee.icon,
        }
      }
      track={checkoutEvent}
    />
  </Section>

  {/* FAQ */}
  <Section
    tone="warm"
    layout="split"
    title={d.faq.title}
    intro={d.faq.intro}
  >
    <Faq items={[...d.faq.items]} />
  </Section>

  {/* Nenhum bloco de artigos aqui.

      A LP é uma página comercial: cada link para fora dela custa conversão
      em campanha paga, e "Leia também" no fim da página oferecia
      exatamente isso a quem acabou de ver o preço. A relação entre artigo e
      produto continua existindo no conteúdo (`product:` no frontmatter) e
      continua valendo numa direção só: o artigo leva à LP, a LP leva ao
      checkout. Os únicos links que restam são os legais, no rodapé. */}

  {/* CTA final */}
  <Section tone="accent" align="center" narrow>
    <div class="final">
      <h2>{d.finalCta.title}</h2>
      <p>{d.finalCta.text}</p>
      <Cta
        href={checkoutHref}
        label={finalCtaLabel}
        variant="inverse"
        size="lg"
        track={checkoutEvent}
      />
      <p class="final-price">{d.price.display} · {d.offer.priceTerms}</p>
    </div>
  </Section>

  {/* Publicidade só depois de toda a argumentação, da oferta e do CTA
      final — nunca no hero, entre benefícios ou perto do preço. Exige a
      posição global ligada E o opt-in deste produto. */}
  {
    d.ads.pageEnd && (
      <div class="container ad-wrap">
        <AdSlot placement="product-page-end" />
      </div>
    )
  }
</ProductLayout>

<style>
  .crumb-bar {
    padding-block: var(--s-4);
  }

  .ad-wrap {
    padding-bottom: var(--section-y);
  }

  /* Mecanismo com foto: uma coluna para a imagem, outra para os pilares.
     No mobile a foto vai para cima e os pilares descem, na ordem em que se
     lê.

     A proporção é 3/2 porque é a que o arquivo sustenta: o original tem
     626x352, e um recorte retrato ao lado de uma coluna alta de cartões
     precisaria ampliar a foto quase duas vezes para preencher. Foto
     ampliada não fica maior, fica borrada. Centralizada na coluna, a
     diferença de altura lê como pareamento editorial, e não como buraco. */
  .method-split {
    display: grid;
    gap: var(--s-6);
    text-align: start;
  }

  .method-figure :global(.product-figure) {
    margin: 0;
  }

  @media (min-width: 60rem) {
    .method-split {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      gap: var(--s-8);
      align-items: center;
    }
  }

  /* Seção com foto ao lado do conteúdo.

     A foto de cena ao lado do argumento vale mais do que a mesma foto
     ocupando largura sozinha entre duas seções: ali ela é intervalo, aqui
     ela é prova do que o texto está dizendo. No celular as duas voltam a
     empilhar, na ordem em que se lê.

     `reverse` inverte a ordem no desktop, para a foto cair do lado que
     sobra depois do bloco de cartões. */
  .side-split {
    display: grid;
    gap: var(--s-6);
    text-align: start;
  }

  .side-figure :global(.product-figure) {
    margin: 0;
  }

  @media (min-width: 62rem) {
    .side-split {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
      gap: var(--s-8);
      align-items: center;
    }

    .side-split-reverse {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    }
  }

  /* A figura logo abaixo do hero respira menos em cima: ela continua a
     composição do topo em vez de abrir um bloco novo. */
  .figure-tight {
    padding-top: var(--s-4);
  }

  /* Faixa do CTA intermediário: uma linha e um botão, lado a lado no
     desktop e empilhados no celular. Sem manchete e sem fundo próprio, para
     não competir com a oferta que vem depois. */
  .midcta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--s-4) var(--s-6);
    padding-block: var(--s-8);
    text-align: center;
  }

  .midcta p {
    margin: 0;
    max-width: 46ch;
    color: var(--color-muted);
  }

  .close {
    margin-top: var(--s-6);
    font-size: var(--t-1);
    font-weight: 600;
    color: var(--color-text);
    max-width: 58ch;
  }

  .note {
    margin-top: var(--s-6);
    font-size: var(--t--1);
    color: var(--color-muted);
    max-width: 68ch;
  }

  /* Duas colunas de texto solto viravam duas manchas cinzas lado a lado,
     sem dizer que são um par em oposição. Como cartões, a comparação fica
     explícita — e o lado que interessa ao leitor certo recebe a cor. */
  /* As figuras editoriais herdam a mesma coluna das seções e mantêm o
     ritmo vertical entre blocos. */
  .figure-wrap {
    padding-block: var(--s-8);
  }

  .note-center {
    margin-inline: auto;
    text-align: center;
    max-width: 60ch;
  }

  /* A nota de checkout pendente segue o alinhamento do bloco em que vive.
     Centralizada aqui, ela para de parecer solta à esquerda da faixa. */
  .final :global(.pending-note) {
    justify-content: center;
  }

  .audience {
    display: grid;
    gap: var(--s-5);
  }

  .aud {
    border-radius: var(--radius-lg);
    padding: var(--s-6);
    border: 1px solid var(--color-border);
  }

  .aud.yes {
    background: var(--color-primary-soft);
    border-color: color-mix(in srgb, var(--color-primary) 22%, transparent);
  }

  .aud.no {
    background: var(--color-surface-raised);
  }

  .audience h3 {
    font-size: var(--t-2);
    margin-bottom: var(--s-5);
  }


---
import ProductLayout from '../layouts/ProductLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import Section from '../components/ui/Section.astro';
import Cta from '../components/ui/Cta.astro';
import Icon from '../components/ui/Icon.astro';
import Hero from '../components/product/Hero.astro';
import BulletList from '../components/product/BulletList.astro';
import CardGrid from '../components/product/CardGrid.astro';
import StepList from '../components/product/StepList.astro';
import ModuleList from '../components/product/ModuleList.astro';
import OfferBox from '../components/product/OfferBox.astro';
import Faq from '../components/product/Faq.astro';
import TestimonialsSection from '../components/testimonials/TestimonialsSection.astro';
import PostCard from '../components/blog/PostCard.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import ProductImage from '../components/product/ProductImage.astro';
import MaterialGrid from '../components/product/MaterialGrid.astro';
import { productImage, missingProductImages } from '../lib/product-images';
import TrackPageEvent from '../components/tracking/TrackPageEvent.astro';
import { eventAttrs } from '../lib/tracking';
import {
  getProducts,
  getPostsByProduct,
  hasCheckout,
  productUrl,
  type Product,
} from '../lib/content';
import * as schema from '../lib/schema';

export async function getStaticPaths() {
  /* Imagem declarada cujo arquivo ainda não chegou. Não é erro — é o que
     permite desenhar a página antes de a fotografia existir. Mas precisa
     aparecer no log, senão o slot silencioso passa despercebido. */
  const missing = await missingProductImages();
  if (missing.length > 0) {
    console.warn(
      `\n[imagens] ${missing.length} imagem(ns) de produto declarada(s) sem arquivo:`
    );
    for (const m of missing) {
      console.warn(`  · ${m.expectedPath}`);
      console.warn(`    ${m.role}`);
      console.warn(`    alt: ${m.alt}`);
    }
    console.warn('');
  }

  const products = await getProducts();

  return products.map((product) => {
    if (!hasCheckout(product)) {
      console.warn(
        `[bookgo] Checkout pendente para "${product.id}": o CTA será renderizado sem link.`
      );
    }
    return {
      params: { product: product.data.slug },
      props: { product },
    };
  });
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const d = product.data;
const path = productUrl(d.slug);
const checkoutHref = hasCheckout(product) ? d.checkout.url : null;
const relatedPosts = await getPostsByProduct(product.id);
const heroImage = productImage(d.slug, d.hero.image);

/**
 * Clique no checkout. É intenção, não compra: nenhum `Purchase` sai daqui —
 * quem conhece a transação é a Kiwify. Ver docs/tracking.md.
 */
const checkoutEvent = eventAttrs('checkout_click', {
  product_slug: d.slug,
  product_name: d.name,
  value: d.price.amount,
  currency: d.price.currency,
});

/* Imagens editoriais, distribuídas pelas âncoras declaradas no YAML.
   Arquivo inexistente não renderiza nada — ver ProductImage.astro. */
const imagesAt = (placement: string) =>
  d.images.filter((i) => i.placement === placement);

const crumbs = [
  { name: 'Início', path: '/' },
  { name: d.name, path },
];
---

<ProductLayout
  title={d.seo.title}
  description={d.seo.description}
  ogImage={d.seo.ogImage}
  theme={d.theme}
  schema={[
    schema.organization(),
    schema.productSchema(product, path),
    schema.breadcrumbs(crumbs),
  ]}
>
  <Hero
    eyebrow={d.hero.eyebrow}
    headline={d.hero.headline}
    subheadline={d.hero.subheadline}
    highlights={[...d.hero.highlights]}
    ctaLabel={d.checkout.cta}
    ctaHref={checkoutHref}
    price={d.price.display}
    image={heroImage}
    imageAlt={d.hero.imageAlt}
    track={checkoutEvent}
  />

  <TrackPageEvent
    event="product_view"
    params={{
      product_slug: d.slug,
      product_name: d.name,
      value: d.price.amount,
      currency: d.price.currency,
    }}
  />

  <div class="crumb-bar container">
    <Breadcrumbs items={crumbs} />
  </div>

  {/* Problema */}
  <Section layout="split" title={d.problem.title} intro={d.problem.intro}>
    <BulletList items={[...d.problem.items]} marker="dot" columns />
    {d.problem.close && <p class="close">{d.problem.close}</p>}
  </Section>

  {/* Mecanismo */}
  {/* Composição central: quebra a sequência de cabeçalhos laterais e dá ao
      mecanismo do produto o peso de um manifesto, não de mais uma lista. */}
  <Section
    tone="warm"
    align="center"
    eyebrow={d.method.name}
    title={d.method.title}
    intro={d.method.intro}
  >
    <CardGrid items={[...d.method.pillars]} cols={2} min="20rem" />
    {d.method.note && <p class="note note-center">{d.method.note}</p>}
  </Section>

  {
    imagesAt('after-method').map((img) => (
      <div class="container figure-wrap">
        <ProductImage
          slug={d.slug}
          src={img.src}
          alt={img.alt}
          caption={img.caption}
        />
      </div>
    ))
  }

  {/* Benefícios */}
  <Section title={d.benefits.title} intro={d.benefits.intro}>
    <CardGrid items={[...d.benefits.items]} feature />
  </Section>

  {/* Como funciona */}
  {/* Jornada horizontal no desktop, empilhada no mobile. Os números deixam
      de ser marcador e passam a ser a estrutura da composição. */}
  <Section
    tone="warm"
    align="center"
    title={d.howItWorks.title}
    intro={d.howItWorks.intro}
  >
    <StepList steps={[...d.howItWorks.steps]} />
  </Section>

  {/* Conteúdo do produto */}
  <Section
    layout="split"
    title={d.contents.title}
    intro={d.contents.intro}
  >
    <ModuleList modules={[...d.contents.modules]} />
  </Section>

  {/* Materiais incluídos */}
  <Section
    tone="warm"
    align="center"
    title={d.materials.title}
    intro={d.materials.intro}
  >
    <MaterialGrid slug={d.slug} items={[...d.materials.items]} />
  </Section>

  {
    imagesAt('after-materials').map((img) => (
      <div class="container figure-wrap">
        <ProductImage
          slug={d.slug}
          src={img.src}
          alt={img.alt}
          caption={img.caption}
        />
      </div>
    ))
  }

  {/* Público */}
  <Section>
    <div class="audience">
      <div class="aud yes">
        <h2>{d.forWho.title}</h2>
        <BulletList items={[...d.forWho.items]} marker="check" />
      </div>
      <div class="aud no">
        <h2>{d.notForWho.title}</h2>
        <BulletList items={[...d.notForWho.items]} marker="minus" />
      </div>
    </div>
  </Section>

  {/* Depoimentos — não renderiza nada enquanto `enabled` for false.
      Fica entre "para quem é" e a oferta: a pessoa acabou de se
      reconhecer no público e ainda não viu o preço. */}
  <TestimonialsSection
    enabled={d.testimonials.enabled}
    demo={d.testimonials.demo}
    title={d.testimonials.title}
    intro={d.testimonials.intro}
    items={[...d.testimonials.items]}
  />

  {
    imagesAt('before-offer').map((img) => (
      <div class="container figure-wrap">
        <ProductImage
          slug={d.slug}
          src={img.src}
          alt={img.alt}
          caption={img.caption}
        />
      </div>
    ))
  }

  {/* Oferta */}
  <Section
    id="oferta"
    tone="soft"
    title={d.offer.title}
    intro={d.offer.intro}
    align="center"
  >
    <OfferBox
      includes={[...d.offer.includes]}
      price={d.price.display}
      priceNote={d.offer.priceNote}
      ctaLabel={d.checkout.cta}
      ctaHref={checkoutHref}
      reassurances={[...(d.offer.reassurances ?? [])]}
      track={checkoutEvent}
    />
  </Section>

  {/* Garantia — faixa horizontal logo abaixo da oferta, ainda dentro do
      momento de decisão. */}
  <Section tone="soft">
    <div class="guarantee">
      {d.guarantee.icon && <Icon name={d.guarantee.icon} class="seal" />}
      <div>
        <h2>{d.guarantee.title}</h2>
        <p>{d.guarantee.text}</p>
      </div>
    </div>
  </Section>

  {/* FAQ */}
  <Section
    tone="warm"
    layout="split"
    title={d.faq.title}
    intro={d.faq.intro}
  >
    <Faq items={[...d.faq.items]} />
  </Section>

  {/* Artigos relacionados */}
  {
    relatedPosts.length > 0 && (
      <Section title="Leia também" layout="split">
        {relatedPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </Section>
    )
  }

  {/* CTA final */}
  <Section tone="accent" align="center" narrow>
    <div class="final">
      <h2>{d.finalCta.title}</h2>
      <p>{d.finalCta.text}</p>
      <Cta
        href={checkoutHref}
        label={d.checkout.cta}
        variant="inverse"
        size="lg"
        track={checkoutEvent}
      />
      <p class="final-price">{d.price.display} · pagamento único</p>

      {
        d.offer.reassurances.length > 0 && (
          <ul class="final-chips">
            {d.offer.reassurances.map((item) => (
              <li>
                <Icon name={item.icon} />
                <span>{item.text}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </Section>

  {/* Publicidade só depois de toda a argumentação, da oferta e do CTA
      final — nunca no hero, entre benefícios ou perto do preço. Exige a
      posição global ligada E o opt-in deste produto. */}
  {
    d.ads.pageEnd && (
      <div class="container ad-wrap">
        <AdSlot placement="product-page-end" />
      </div>
    )
  }
</ProductLayout>

<style>
  .crumb-bar {
    padding-block: var(--s-4);
  }

  .ad-wrap {
    padding-bottom: var(--section-y);
  }

  .close {
    margin-top: var(--s-6);
    font-size: var(--t-1);
    font-weight: 600;
    color: var(--color-text);
    max-width: 58ch;
  }

  .note {
    margin-top: var(--s-6);
    font-size: var(--t--1);
    color: var(--color-muted);
    max-width: 68ch;
  }

  /* Duas colunas de texto solto viravam duas manchas cinzas lado a lado,
     sem dizer que são um par em oposição. Como cartões, a comparação fica
     explícita — e o lado que interessa ao leitor certo recebe a cor. */
  /* As figuras editoriais herdam a mesma coluna das seções e mantêm o
     ritmo vertical entre blocos. */
  .figure-wrap {
    padding-block: var(--s-8);
  }

  .note-center {
    margin-inline: auto;
    text-align: center;
    max-width: 60ch;
  }

  /* As mesmas reasseguranças da oferta fecham a página. Quem rolou até aqui
     sem comprar costuma estar decidindo entre "agora" e "depois" — repetir
     garantia e acesso é responder a isso, não repetir por repetir. */
  /* A nota de checkout pendente segue o alinhamento do bloco em que vive.
     Centralizada aqui, ela para de parecer solta à esquerda da faixa. */
  .final :global(.pending-note) {
    justify-content: center;
  }

  .final-chips {
    list-style: none;
    padding: 0;
    margin: var(--s-7) auto 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3) var(--s-5);
    max-width: 48rem;
  }

  .final-chips li {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t--1);
    color: color-mix(in srgb, var(--color-on-primary) 88%, transparent);
  }

  .final-chips :global(.icon) {
    --icon-size: 1rem;
    opacity: 0.9;
  }

  .audience {
    display: grid;
    gap: var(--s-5);
  }

  .aud {
    border-radius: var(--radius-lg);
    padding: var(--s-6);
    border: 1px solid var(--color-border);
  }

  .aud.yes {
    background: var(--color-primary-soft);
    border-color: color-mix(in srgb, var(--color-primary) 22%, transparent);
  }

  .aud.no {
    background: var(--color-surface-raised);
  }

  .audience h2 {
    font-size: var(--t-2);
    margin-bottom: var(--s-5);
  }

  @media (min-width: 56rem) {
    .audience {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-6);
    }

    .aud {
      padding: var(--s-7);
    }
  }

  /* Faixa larga em vez de caixinha centrada com meia página vazia em volta.
     O escudo ganha um disco próprio para não flutuar solto ao lado do texto. */
  .guarantee {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--s-6);
    display: flex;
    align-items: center;
    gap: var(--s-5);
    box-shadow: var(--shadow-sm);
  }

  .guarantee :global(.seal) {
    --icon-size: 1.75rem;
    color: var(--color-primary-dark);
    flex: none;
    box-sizing: content-box;
    padding: var(--s-4);
    border-radius: 50%;
    background: var(--color-primary-soft);
  }

  @media (max-width: 40rem) {
    .guarantee {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-4);
    }
  }

  .guarantee h2 {
    font-size: var(--t-1);
  }

  .guarantee p {
    margin-top: var(--s-2);
    max-width: 68ch;
  }

  .guarantee p {
    margin-top: var(--s-3);
    color: var(--color-muted);
  }

  .final {
    text-align: center;
  }

  .final p {
    margin-top: var(--s-4);
    margin-bottom: var(--s-6);
    color: color-mix(in srgb, var(--color-on-primary) 84%, transparent);
    max-width: 56ch;
    margin-inline: auto;
  }

  .final-price {
    margin-top: var(--s-5);
    margin-bottom: 0;
    font-size: var(--t--1);
  }

  @media (min-width: 46rem) {
    .audience {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-9);
    }
  }
</style>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import PillButton from '../components/ui/PillButton.astro';
import Marquee from '../components/ui/Marquee.astro';
import { SITE, NAV_CTA } from '../config/site';
import { getCategories, categoryUrl } from '../lib/content';
import * as schema from '../lib/schema';

const HERO_TOPICS = [
  'Organização',
  'Tecnologia',
  'Família',
  '50+',
  'Dinheiro',
  'Carreira',
  'Empreendedorismo',
] as const;

const FORMATS = [
  'Cursos rápidos',
  'Guias práticos',
  'Checklists',
  'Planners',
  'Templates',
  'Materiais digitais',
] as const;

const PILLARS = [
  {
    title: 'Aprenda rápido',
    text: 'Conteúdo direto ao ponto, sem horas de teoria desnecessária.',
  },
  {
    title: 'Coloque em prática',
    text: 'Guias, checklists e materiais para acompanhar o aprendizado.',
  },
  {
    title: 'No seu ritmo',
    text: 'Acesse quando quiser e avance de acordo com sua rotina.',
  },
];

/** Vitrine de categorias. Hoje só organização existe; o componente já
 *  aceita as próximas sem mudança de código. */
const categories = await getCategories();
const featured = categories.slice(0, 1).map((category) => ({
  name: 'Casa e organização',
  text: 'Métodos simples e materiais práticos para deixar a rotina mais leve.',
  cta: 'Explorar organização',
  href: categoryUrl(category.id),
}));
---

<SiteLayout
  title={SITE.name}
  description={SITE.description}
  schema={[schema.organization()]}
>
  {/* ── Hero ─────────────────────────────────────────────── */}
  <section class="hero">
    <div class="container">
      <div class="hero-card">
        <div class="hero-art" aria-hidden="true">
          <span class="ring r1"></span>
          <span class="ring r2"></span>
          <span class="ring r3"></span>
        </div>

        <div class="hero-body">
          <h1>
            <span>Aprenda algo útil.</span>
            <span>Coloque em prática.</span>
          </h1>
          <p class="hero-sub">
            Cursos rápidos, guias e materiais práticos para resolver problemas
            reais do dia a dia, no seu ritmo.
          </p>
          <PillButton
            href={NAV_CTA.href}
            label={NAV_CTA.label}
            variant="inverse"
            size="lg"
            arrow
          />
        </div>

        <div class="hero-marquee">
          <Marquee items={HERO_TOPICS} variant="hero" duration="38s" />
        </div>
      </div>
    </div>
  </section>

  {/* ── Proposta ─────────────────────────────────────────── */}
  <section class="section" id="sobre">
    <div class="container">
      <header class="head">
        <h2>Conhecimento para a vida real.</h2>
        <p class="lede">
          A BookGo transforma assuntos importantes em conteúdos objetivos,
          organizados e fáceis de colocar em prática.
        </p>
      </header>

      <ul class="pillars">
        {
          PILLARS.map((pillar) => (
            <li>
              <h3>{pillar.title}</h3>
              <p>{pillar.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── Faixa de formatos ────────────────────────────────── */}
  <section class="band" aria-label="Formatos disponíveis">
    <Marquee items={FORMATS} variant="band" duration="52s" />
  </section>

  {/* ── Explorar ─────────────────────────────────────────── */}
  <section class="section" id="explorar">
    <div class="container">
      <header class="head">
        <p class="eyebrow">Explore a BookGo</p>
        <h2>Encontre algo para você.</h2>
        <p class="lede">
          Conteúdos criados para diferentes momentos, objetivos e rotinas.
        </p>
      </header>

      <ul class="categories">
        {
          featured.map((category) => (
            <li class="category">
              <div class="category-body">
                <h3>{category.name}</h3>
                <p>{category.text}</p>
                <PillButton href={category.href} label={category.cta} arrow />
              </div>
              <div class="category-art" aria-hidden="true">
                <span class="sheet s1"></span>
                <span class="sheet s2"></span>
                <span class="sheet s3"></span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</SiteLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    padding-block: var(--s-2) var(--s-6);
  }

  .hero-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--bookgo-blue);
    color: #ffffff;
    min-height: min(46rem, calc(100svh - 6.5rem));
    padding: clamp(1.75rem, 1.2rem + 2.4vw, 3.5rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--s-8);
  }

  /* Composição abstrata própria: anéis concêntricos recortados pela
     borda do card, sobre um brilho suave. Puro CSS, nenhuma imagem. */
  .hero-art {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        44rem 30rem at 88% 6%,
        color-mix(in srgb, #ffffff 16%, transparent),
        transparent 70%
      ),
      radial-gradient(
        30rem 30rem at 6% 96%,
        color-mix(in srgb, #000000 14%, transparent),
        transparent 68%
      );
  }

  .ring {
    position: absolute;
    right: -14%;
    top: 50%;
    translate: 0 -50%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, #ffffff 22%, transparent);
  }

  .r1 {
    width: min(58rem, 108vw);
  }

  .r2 {
    width: min(42rem, 82vw);
    border-color: color-mix(in srgb, #ffffff 16%, transparent);
  }

  .r3 {
    width: min(26rem, 56vw);
    background: color-mix(in srgb, #ffffff 6%, transparent);
    border-color: color-mix(in srgb, #ffffff 12%, transparent);
  }

  .hero-body {
    max-width: 34rem;
    margin-top: auto;
  }

  .hero-body h1 {
    display: grid;
  }

  .hero-sub {
    margin-block: var(--s-5) var(--s-7);
    font-size: var(--t-1);
    color: color-mix(in srgb, #ffffff 82%, transparent);
    max-width: 30rem;
  }

  .hero-marquee {
    margin-inline: calc(-1 * clamp(1.75rem, 1.2rem + 2.4vw, 3.5rem));
  }

  /* ── Seções ───────────────────────────────────────────────── */
  .section {
    padding-block: var(--section-y);
  }

  .head {
    max-width: var(--w-text);
    margin-bottom: var(--s-9);
  }

  .head > * + * {
    margin-top: var(--s-4);
  }

  /* ── Pilares: um card alto e dois empilhados ──────────────── */
  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-4);
  }

  .pillars li {
    padding: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: border-color var(--dur) var(--ease);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 13rem;
  }

  .pillars li:first-child {
    background: var(--bookgo-blue-light);
    border-color: color-mix(in srgb, var(--bookgo-blue) 14%, transparent);
  }

  .pillars h3 {
    font-size: var(--t-3);
  }

  .pillars p {
    margin-top: var(--s-3);
    color: var(--color-muted);
    max-width: 32ch;
  }

  /* ── Faixa institucional ──────────────────────────────────── */
  .band {
    padding-block: var(--s-6);
    border-block: 1px solid var(--color-border);
  }

  /* ── Categorias ───────────────────────────────────────────── */
  .categories {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-5);
  }

  .category {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: var(--s-8);
    padding: clamp(1.75rem, 1.2rem + 2.4vw, 3.5rem);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .category-body {
    max-width: 30rem;
    align-self: center;
  }

  .category h3 {
    font-size: var(--t-4);
    letter-spacing: var(--tr-heading);
  }

  .category-body p {
    margin-block: var(--s-4) var(--s-7);
    color: var(--color-muted);
    font-size: var(--t-1);
  }

  /* Folhas empilhadas: sugerem material sem recorrer a ícone. */
  .category-art {
    position: relative;
    min-height: 11rem;
  }

  .sheet {
    position: absolute;
    border-radius: var(--radius);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
  }

  .s1 {
    inset: 18% 30% 6% 4%;
    rotate: -5deg;
  }

  .s2 {
    inset: 10% 16% 14% 18%;
    rotate: 3deg;
  }

  .s3 {
    inset: 4% 4% 22% 32%;
    rotate: 9deg;
    background: var(--bookgo-blue);
    border-color: transparent;
  }

  @media (min-width: 60rem) {
    .pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pillars li:first-child {
      grid-row: span 2;
    }

    .category {
      grid-template-columns: 1fr 0.85fr;
      align-items: center;
    }

    .category-art {
      min-height: 15rem;
    }
  }
</style>

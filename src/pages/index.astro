---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import PillButton from '../components/ui/PillButton.astro';
import Marquee from '../components/ui/Marquee.astro';
import Icon from '../components/ui/Icon.astro';
import PostCard from '../components/blog/PostCard.astro';
import ProductCard from '../components/product/ProductCard.astro';
import { SITE, NAV_CTA } from '../config/site';
import {
  getCategories,
  getPosts,
  getPillars,
  getPostsByPillar,
  getFeaturedProduct,
  getProductsByCategory,
  pillarUrl,
  productUrl,
} from '../lib/content';
import { categoryCover } from '../lib/category-images';
import { themeToStyle } from '../lib/theme';
import * as schema from '../lib/schema';

const HERO_TOPICS = [
  'Organização',
  'Tecnologia',
  'Família',
  '50+',
  'Dinheiro',
  'Carreira',
  'Empreendedorismo',
] as const;

const FORMATS = [
  'Métodos práticos',
  'Guias práticos',
  'Checklists',
  'Planners',
  'Templates',
  'Materiais digitais',
] as const;

/**
 * Princípios da BookGo.
 *
 * Descrevem como o material é feito, não a história da empresa. Nenhum
 * número, nenhum tempo de mercado, nenhuma contagem de clientes: não há
 * dado real por trás de nada disso, e uma seção "sobre" é exatamente onde
 * esse tipo de invenção costuma entrar.
 */
const PRINCIPLES = [
  {
    icon: 'spark' as const,
    title: 'Objetivo antes de extenso',
    text: 'O material termina quando o problema está resolvido, não quando alcança uma quantidade de páginas.',
  },
  {
    icon: 'checklist' as const,
    title: 'Feito para aplicar',
    text: 'Cada material vem com checklist, planner ou template. Ler é o meio, usar é o ponto.',
  },
  {
    icon: 'shield' as const,
    title: 'Sem promessa que não se sustenta',
    text: 'Nada de resultado garantido, contagem regressiva ou vaga limitada. O que a página afirma é o que o material entrega.',
  },
];

/**
 * Vitrine de pilares, montada a partir dos pilares reais.
 *
 * Pilar, não categoria: Organização e Cozinha vivem dentro de Casa, e
 * mostrá-las lado a lado na home as apresentaria como temas independentes,
 * contradizendo a árvore que a própria navegação usa.
 *
 * Nenhum pilar é inventado para fechar a linha da grade: com um só, aparece
 * um só. A capa é resolvida pelo id, então um pilar novo entra aqui sem
 * tocar neste arquivo.
 *
 * A contagem de artigos é calculada, nunca escrita à mão. Mesmo assim só
 * aparece a partir de três: "1 artigo" não informa nada que o próprio card
 * já não diga, e anunciar escassez de conteúdo não ajuda ninguém.
 */
const categories = await getCategories();
const pillars = await getPillars();
const categoryCards = await Promise.all(
  pillars.map(async (pillar) => {
    const posts = await getPostsByPillar(pillar.id);
    return {
      id: pillar.id,
      name: pillar.data.name,
      text: pillar.data.description,
      href: pillarUrl(pillar.id),
      cover: categoryCover(pillar.id),
      count: posts.length >= 3 ? posts.length : null,
    };
  })
);

/** Últimos artigos publicados. `getPosts` já ordena e exclui rascunhos. */
const latestPosts = (await getPosts()).slice(0, 3);
const categoryNameById = new Map(categories.map((c) => [c.id, c.data.name]));

/** Material em destaque, declarado no YAML do produto. */
const featuredProduct = await getFeaturedProduct();

/** Materiais práticos, agrupados pela categoria declarada em cada um. */
const productGroups = await getProductsByCategory();
---

<SiteLayout
  title={SITE.name}
  description={SITE.description}
  schema={[schema.organization(), schema.website()]}
>
  {/* ── Hero ─────────────────────────────────────────────── */}
  <section class="hero">
    <div class="container">
      <div class="hero-card">
        <div class="hero-art" aria-hidden="true">
          <span class="ring r1"></span>
          <span class="ring r2"></span>
          <span class="ring r3"></span>
        </div>

        <div class="hero-body">
          <h1>
            <span>Aprenda algo útil.</span>
            <span>Coloque em prática.</span>
          </h1>
          <p class="hero-sub">
            Métodos, guias e materiais práticos para resolver problemas reais
            do dia a dia, no seu ritmo.
          </p>
          <PillButton
            href={NAV_CTA.href}
            label={NAV_CTA.label}
            variant="inverse"
            size="lg"
            arrow
          />
        </div>

        <div class="hero-marquee">
          <Marquee items={HERO_TOPICS} variant="hero" duration="38s" />
        </div>
      </div>
    </div>
  </section>

  {/* ── Sobre a BookGo ───────────────────────────────────── */}
  <section class="section about" id="sobre">
    <div class="container about-grid">
      <header class="about-head">
        <p class="eyebrow">Sobre a BookGo</p>
        <h2>Material prático para resolver um problema de cada vez.</h2>
      </header>

      <div class="about-text">
        <p>
          A BookGo publica métodos, guias e materiais digitais sobre assuntos
          do dia a dia. Cada material nasce de um problema concreto e entrega
          um jeito de resolvê-lo.
        </p>
        <p>
          O formato é sempre o mesmo: texto direto para entender, checklist
          ou planner para aplicar. Você usa enquanto aprende, no seu ritmo,
          sem depender de aula longa nem de um fim de semana livre.
        </p>
      </div>

      <ul class="principles">
        {
          PRINCIPLES.map((principle) => (
            <li>
              <Icon name={principle.icon} class="lead" />
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── Faixa de formatos ────────────────────────────────── */}
  <section class="band" aria-label="Formatos disponíveis">
    <Marquee items={FORMATS} variant="band" duration="52s" />
  </section>

  {/* ── Explorar categorias ──────────────────────────────── */}
  <section class="section" id="explorar">
    <div class="container">
      <header class="head">
        <p class="eyebrow">Explore a BookGo</p>
        <h2>Por onde começar.</h2>
        <p class="lede">
          Cada categoria reúne os conteúdos e os materiais de um assunto.
        </p>
      </header>

      <ul class="categories">
        {
          categoryCards.map((category) => (
            <li class:list={['category', { 'has-cover': category.cover }]} data-card>
              {category.cover && (
                <Image
                  class="category-cover"
                  src={category.cover}
                  alt=""
                  widths={[480, 720, 1024]}
                  sizes="(min-width: 60rem) 34rem, calc(100vw - 2 * var(--gutter))"
                  loading="lazy"
                  decoding="async"
                  quality={68}
                />
              )}
              <div class="category-body">
                <h3>
                  <a href={category.href}>
                    <span class="overlay" />
                    {category.name}
                  </a>
                </h3>
                <p>{category.text}</p>
                {category.count && <p class="count">{category.count} artigos</p>}
                <span class="go" aria-hidden="true">
                  Explorar
                  <Icon name="arrow-right" class="u-arrow" />
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── Material em destaque ─────────────────────────────── */}
  {
    featuredProduct && (
      <section class="section tone-soft">
        <div class="container">
          <header class="head">
            <p class="eyebrow">Material em destaque</p>
            <h2>Feito para caber numa rotina que não para.</h2>
          </header>

          <article
            class="product"
            style={themeToStyle(featuredProduct.data.theme)}
            data-card
          >
            <div class="product-body">
              <h3>
                <a href={productUrl(featuredProduct.data.slug)}>
                  <span class="overlay" />
                  {featuredProduct.data.name}
                </a>
              </h3>
              <p>{featuredProduct.data.tagline}</p>
              <p class="product-meta">
                <span class="price">{featuredProduct.data.price.display}</span>
                <span>pagamento único</span>
              </p>
            </div>
            <span class="go" aria-hidden="true">
              Conhecer o método
              <Icon name="arrow-right" class="u-arrow" />
            </span>
          </article>
        </div>
      </section>
    )
  }

  {/* ── Últimos artigos ──────────────────────────────────── */}
  {
    latestPosts.length > 0 && (
      <section class="section">
        <div class="container">
          <header class="head row">
            <div>
              <p class="eyebrow">Do blog</p>
              <h2>Últimos artigos.</h2>
            </div>
            <PillButton href="/blog/" label="Ver todos" arrow />
          </header>

          <ul class="posts">
            {latestPosts.map((post) => (
              <li>
                <PostCard
                  post={post}
                  categoryName={categoryNameById.get(post.data.category.id)}
                  thumbnail
                />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {/* ── Materiais práticos ───────────────────────────────────
      O catálogo dos produtos próprios, agrupado pela categoria que cada
      um declara no seu YAML. Nenhum cartão é escrito aqui: material novo
      entra por existir, e categoria sem material publicado simplesmente
      não aparece.

      Fica depois do blog de propósito. O destaque já estabelece, lá em
      cima, que a BookGo tem produtos próprios; repetir o mesmo cartão
      duas telas antes transformaria a home numa sequência de chamadas
      comerciais, que é o oposto da hierarquia editorial dela.

      Os cartões levam à landing page, nunca ao checkout. */}
  {
    productGroups.length > 0 && (
      <section class="section tone-warm" id="materiais">
        <div class="container">
          <header class="head">
            <p class="eyebrow">Materiais práticos</p>
            <h2>Métodos, guias e materiais para colocar em prática no seu ritmo.</h2>
          </header>

          <div class="groups">
            {productGroups.map((group) => (
              <section class="group" aria-labelledby={`grupo-${group.id}`}>
                <h3 class="group-title" id={`grupo-${group.id}`}>
                  {group.label}
                </h3>
                <ul class="products">
                  {group.products.map((product) => (
                    <li>
                      <ProductCard product={product} />
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
      </section>
    )
  }
</SiteLayout>

<style>
  /* Materiais práticos: uma prateleira por categoria. A grade usa
     `auto-fill`, e não `auto-fit`, para que uma categoria com um material
     só ocupe uma célula em vez de esticar pela faixa inteira. */
  .groups {
    display: grid;
    gap: var(--s-8);
  }

  .group-title {
    font-size: var(--t--1);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    font-weight: var(--w-semibold);
    color: var(--color-muted);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--s-5);
  }

  .products {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-5);
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
  }

  @media (min-width: 64rem) {
    .products {
      grid-template-columns: repeat(auto-fill, minmax(min(22rem, 100%), 1fr));
    }
  }

  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    padding-block: var(--s-2) var(--s-6);
  }

  .hero-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--bookgo-blue);
    color: #ffffff;
    min-height: min(46rem, calc(100svh - 6.5rem));
    padding: clamp(1.75rem, 1.2rem + 2.4vw, 3.5rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--s-8);
  }

  /* Composição abstrata própria: anéis concêntricos recortados pela
     borda do card, sobre um brilho suave. Puro CSS, nenhuma imagem. */
  .hero-art {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        44rem 30rem at 88% 6%,
        color-mix(in srgb, #ffffff 16%, transparent),
        transparent 70%
      ),
      radial-gradient(
        30rem 30rem at 6% 96%,
        color-mix(in srgb, #000000 14%, transparent),
        transparent 68%
      );
  }

  .ring {
    position: absolute;
    right: -14%;
    top: 50%;
    translate: 0 -50%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, #ffffff 22%, transparent);
  }

  .r1 {
    width: min(58rem, 108vw);
  }

  .r2 {
    width: min(42rem, 82vw);
    border-color: color-mix(in srgb, #ffffff 16%, transparent);
  }

  .r3 {
    width: min(26rem, 56vw);
    background: color-mix(in srgb, #ffffff 6%, transparent);
    border-color: color-mix(in srgb, #ffffff 12%, transparent);
  }

  .hero-body {
    /* Larga o bastante para "Coloque em prática." caber numa linha só
       no tamanho máximo da fonte. */
    max-width: 40rem;
    margin-top: auto;
  }

  .hero-body h1 {
    display: grid;
  }

  .hero-sub {
    margin-block: var(--s-5) var(--s-7);
    font-size: var(--t-1);
    color: color-mix(in srgb, #ffffff 82%, transparent);
    max-width: 32rem;
  }

  .hero-marquee {
    margin-inline: calc(-1 * clamp(1.75rem, 1.2rem + 2.4vw, 3.5rem));
  }

  /* ── Seções ───────────────────────────────────────────────── */
  .section {
    padding-block: var(--section-y);
  }

  .head {
    max-width: var(--w-text);
    margin-bottom: var(--s-9);
  }

  .head > * + * {
    margin-top: var(--s-4);
  }

  .head.row {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--s-5);
  }

  .head.row > div > * + * {
    margin-top: var(--s-4);
  }

  /* Faixa alternada: separa a sequência de seções sem exigir uma borda. */
  .tone-soft {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  /* ── Sobre ────────────────────────────────────────────────── */
  .about-grid {
    display: grid;
    gap: var(--s-6);
  }

  .about-head h2 {
    margin-top: var(--s-3);
    font-size: var(--t-4);
    max-width: 18ch;
    text-wrap: balance;
  }

  .about-text {
    display: grid;
    gap: var(--s-4);
    max-width: var(--w-text);
    color: var(--color-muted);
    font-size: var(--t-0);
    line-height: 1.6;
  }

  /* Três princípios em linha: a seção explica o que a BookGo faz com uma
     manchete e dois parágrafos, e os princípios dizem como. Em bloco de
     texto corrido, a diferença entre as duas coisas se perderia. */
  .principles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-4);
  }

  .principles li {
    padding: var(--s-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
  }

  .principles :global(.lead) {
    --icon-size: 1.5rem;
    display: block;
    margin-bottom: var(--s-4);
    color: var(--color-primary);
  }

  .principles h3 {
    font-size: var(--t-1);
  }

  .principles p {
    margin-top: var(--s-2);
    color: var(--color-muted);
    font-size: var(--t--1);
    line-height: 1.55;
  }

  /* ── Faixa de formatos ────────────────────────────────────── */
  .band {
    padding-block: var(--s-6);
    border-block: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  /* ── Categorias ───────────────────────────────────────────── */
  .categories {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-5);
    /* `auto-fill`, não `auto-fit`: com uma categoria só, `auto-fit`
       colapsaria a linha e o card ocuparia a faixa inteira. */
    grid-template-columns: repeat(auto-fill, minmax(min(26rem, 100%), 1fr));
  }

  .category {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-surface-raised);
    min-height: 22rem;
    display: flex;
    align-items: flex-end;
  }

  /* Com foto, o card vira superfície escura e o texto passa a ser branco.
     O degradê não é enfeite: é o que garante contraste de leitura sobre uma
     fotografia que muda de claro para escuro ao longo do quadro. */
  .category.has-cover {
    border-color: transparent;
  }

  .category-cover {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .category.has-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      color-mix(in srgb, #101210 92%, transparent) 0%,
      color-mix(in srgb, #101210 58%, transparent) 46%,
      color-mix(in srgb, #101210 12%, transparent) 100%
    );
  }

  .category-body {
    padding: var(--s-6);
  }

  .category h3 {
    font-size: var(--t-2);
  }

  .category h3 a {
    color: inherit;
    text-decoration: none;
  }

  /* O link cobre o card inteiro e mantém um só alvo de foco. */
  .overlay {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .category-body p {
    margin-top: var(--s-2);
    color: var(--color-muted);
    font-size: var(--t-0);
    max-width: 42ch;
  }

  .category.has-cover,
  .category.has-cover .category-body p {
    color: #ffffff;
  }

  .category.has-cover .category-body p {
    color: color-mix(in srgb, #ffffff 82%, transparent);
  }

  .count {
    font-size: var(--t--1);
  }

  .go {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-5);
    font-size: var(--t--1);
    font-weight: var(--w-semibold);
    color: var(--color-primary);
  }

  .go :global(.icon) {
    --icon-size: 1rem;
  }

  .category.has-cover .go {
    color: #ffffff;
  }

  /* ── Material em destaque ─────────────────────────────────── */
  .product {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--s-5);
    padding: clamp(1.5rem, 1.2rem + 1.6vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    /* Paleta do próprio produto: quem clica cai numa landing page com as
       mesmas cores, e o card já anuncia isso. */
    background: var(--color-primary-soft);
    border-color: color-mix(in srgb, var(--color-primary) 24%, var(--color-border));
  }

  .product h3 {
    font-size: var(--t-2);
    max-width: 20ch;
  }

  .product h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .product-body > p {
    margin-top: var(--s-3);
    color: var(--color-muted);
    font-size: var(--t-0);
    max-width: 52ch;
  }

  .product-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-3);
    margin-top: var(--s-4);
    font-size: var(--t--1);
  }

  .price {
    font-size: var(--t-1);
    font-weight: var(--w-semibold);
    color: var(--color-text);
  }

  /* ── Últimos artigos ──────────────────────────────────────── */
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-5);
    grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
  }

  @media (min-width: 60rem) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--s-7) var(--s-9);
      align-items: start;
    }

    .about-text {
      padding-top: var(--s-2);
    }

    .principles {
      grid-column: 1 / -1;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-5);
      margin-top: var(--s-6);
    }
  }

  @media (min-width: 76rem) {
    .posts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

---
/**
 * Página do pilar: a entrada de um grande tema editorial.
 *
 * Mostra as categorias que existem dentro dele e os artigos recentes de
 * todas elas. Nenhuma contagem inventada e nenhum card vazio: categoria sem
 * artigo continua aparecendo, porque ela é um caminho válido, mas nada na
 * página afirma quantidade que não existe.
 */
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../../components/seo/Breadcrumbs.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import Icon from '../../../components/ui/Icon.astro';
import {
  getPillars,
  getCategoriesByPillar,
  getPostsByPillar,
  categoryUrl,
  pillarUrl,
  type Category,
  type Pillar,
  type Post,
} from '../../../lib/content';
import * as schema from '../../../lib/schema';

export async function getStaticPaths() {
  const pillars = await getPillars();

  return Promise.all(
    pillars.map(async (pillar) => ({
      params: { pillar: pillar.id },
      props: {
        pillar,
        categories: await getCategoriesByPillar(pillar.id),
        posts: (await getPostsByPillar(pillar.id)).slice(0, 6),
      },
    }))
  );
}

interface Props {
  pillar: Pillar;
  categories: Category[];
  posts: Post[];
}

const { pillar, categories, posts } = Astro.props;
const d = pillar.data;
const path = pillarUrl(pillar.id);

const categoryNameById = new Map(categories.map((c) => [c.id, c.data.name]));

const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: d.name, path },
];
---

<SiteLayout
  title={d.seo.title ?? d.name}
  description={d.seo.description ?? d.description}
  schema={[schema.organization(), schema.website(), schema.breadcrumbs(crumbs)]}
>
  <div class="container crumb-bar">
    <Breadcrumbs items={crumbs} />
  </div>

  <div class="hero-band">
    <header class="container page-head">
      <div>
        <p class="eyebrow">Pilar</p>
        <h1>{d.headline ?? d.name}</h1>
      </div>

      {
        d.intro.length > 0 ? (
          <div class="intro">
            {d.intro.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        ) : (
          <p class="intro">{d.description}</p>
        )
      }
    </header>
  </div>

  {
    categories.length > 0 && (
      <section class="container subs" aria-labelledby="assuntos">
        <h2 id="assuntos">Assuntos</h2>
        <ul>
          {categories.map((category) => (
            <li data-card>
              <h3>
                <a href={categoryUrl(category.id)}>
                  <span class="overlay" />
                  {category.data.name}
                </a>
              </h3>
              <p>{category.data.description}</p>
              <span class="go" aria-hidden="true">
                Ver conteúdos
                <Icon name="arrow-right" class="u-arrow" />
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="container posts-wrap" aria-labelledby="recentes">
        <h2 id="recentes">Publicados recentemente</h2>
        <ul class="posts">
          {posts.map((post) => (
            <li>
              <PostCard
                post={post}
                categoryName={categoryNameById.get(post.data.category.id)}
                thumbnail
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</SiteLayout>

<style>
  .crumb-bar {
    padding-block: var(--s-5) var(--s-2);
  }

  .hero-band {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--s-9);
  }

  .page-head {
    padding-block: var(--section-y-tight) var(--s-8);
  }

  .page-head h1 {
    margin-top: var(--s-3);
    font-size: var(--t-4);
    max-width: 18ch;
    text-wrap: balance;
  }

  .intro {
    display: grid;
    gap: var(--s-4);
    max-width: var(--w-text);
    margin-top: var(--s-5);
    color: var(--color-muted);
    line-height: 1.58;
  }

  .subs,
  .posts-wrap {
    padding-bottom: var(--s-9);
  }

  .subs h2,
  .posts-wrap h2 {
    font-size: var(--t--1);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: var(--s-5);
  }

  .subs ul,
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-5);
  }

  .subs ul {
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
  }

  .subs li {
    position: relative;
    padding: var(--s-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
  }

  .subs h3 {
    font-size: var(--t-2);
  }

  .subs h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .overlay {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .subs p {
    margin-top: var(--s-2);
    color: var(--color-muted);
    font-size: var(--t-0);
    max-width: 42ch;
  }

  .go {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-5);
    font-size: var(--t--1);
    font-weight: var(--w-semibold);
    color: var(--color-primary);
  }

  .go :global(.icon) {
    --icon-size: 1rem;
  }

  .posts {
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
  }

  @media (min-width: 60rem) {
    .page-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--s-9);
      align-items: end;
    }

    .intro {
      margin-top: 0;
    }
  }

  @media (min-width: 76rem) {
    .posts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../../components/seo/Breadcrumbs.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import CategoryChips from '../../../components/blog/CategoryChips.astro';
import {
  getCategories,
  getPostsByCategory,
  categoryUrl,
  type Category,
  type Post,
} from '../../../lib/content';
import * as schema from '../../../lib/schema';

export async function getStaticPaths() {
  const categories = await getCategories();

  return Promise.all(
    categories.map(async (category) => ({
      params: { category: category.id },
      props: {
        category,
        categories,
        posts: await getPostsByCategory(category.id),
      },
    }))
  );
}

interface Props {
  category: Category;
  categories: Category[];
  posts: Post[];
}

const { category, categories, posts } = Astro.props;
const d = category.data;
const path = categoryUrl(category.id);

const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: d.name, path },
];
---

<SiteLayout
  title={d.seo.title ?? d.name}
  description={d.seo.description ?? d.description}
  schema={[schema.organization(), schema.breadcrumbs(crumbs)]}
>
  <div class="container crumb-bar">
    <Breadcrumbs items={crumbs} />
  </div>

  <header class="container page-head">
    <h1>{d.name}</h1>
    <p class="lede">{d.description}</p>
    <CategoryChips categories={categories} current={category.id} />
  </header>

  <div class="container posts-wrap">
    {
      posts.length > 0 ? (
        <ul class="posts">
          {posts.map((post, index) => (
            <li class:list={{ wide: index === 0 }}>
              <PostCard post={post} featured={index === 0} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">Nenhum artigo publicado nesta categoria ainda.</p>
      )
    }
  </div>
</SiteLayout>

<style>
  .crumb-bar {
    padding-block: var(--s-5) var(--s-2);
  }

  .page-head {
    padding-block: var(--section-y-tight) var(--s-8);
  }

  .page-head h1 {
    font-size: var(--t-4);
  }

  .page-head .lede {
    margin-block: var(--s-4) var(--s-7);
    max-width: 46ch;
  }

  .posts-wrap {
    padding-bottom: var(--section-y);
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-4);
  }

  .empty {
    color: var(--color-muted);
  }

  @media (min-width: 52rem) {
    .posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .posts .wide {
      grid-column: 1 / -1;
    }
  }
</style>

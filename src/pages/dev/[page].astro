---
/**
 * Vitrine de componentes — **só existe em `astro dev`**.
 *
 * `getStaticPaths` devolve lista vazia no build de produção, então nenhuma
 * destas rotas gera arquivo em `dist/`: não há URL, não entra no sitemap,
 * não entra no llms.txt e não existe "página oculta" publicada. Rodar
 * `npm run dev` e abrir /dev/componentes/ ou /dev/avaliacoes/ é o único
 * caminho.
 *
 * O conteúdo abaixo é **demonstração de layout**, não avaliação. Os textos
 * dizem isso de forma explícita justamente para que ninguém, nem por engano,
 * copie daqui para uma LP: avaliação real só entra quando existir, escrita e
 * autorizada por uma pessoa.
 *
 * `/dev/avaliacoes/` existe por um motivo de engenharia: a seção precisa
 * funcionar com qualquer quantidade, e a única forma de conferir isso é ver
 * 0, 1, 2, 3, 6 e 10 lado a lado. Os dados são fixtures daqui, e nenhum
 * deles toca no YAML de produto nenhum.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import ReviewsSection from '../../components/reviews/ReviewsSection.astro';
import { ICON_NAMES } from '../../lib/icons';

export function getStaticPaths() {
  /* Em produção, nenhuma rota. Em dev, duas. */
  if (import.meta.env.PROD) return [];
  return [{ params: { page: 'componentes' } }, { params: { page: 'avaliacoes' } }];
}

const { page } = Astro.params;

const demoConversa = {
  type: 'phone' as const,
  name: 'Exemplo de conversa',
  status: 'conteúdo de demonstração',
  messages: [
    {
      side: 'incoming' as const,
      text: 'Esta é uma mensagem de exemplo. Serve para conferir a altura da bolha, a quebra de linha e o alinhamento à esquerda.',
      time: '09:12',
      read: false,
    },
    {
      side: 'outgoing' as const,
      text: 'Resposta de exemplo, alinhada à direita, com horário e confirmação de leitura.',
      time: '09:14',
      read: true,
    },
    {
      side: 'incoming' as const,
      text: 'Terceira bolha, para ver a cascata de entrada rodando uma vez só.',
      time: '09:15',
      read: false,
    },
  ],
};

const demoCartao = {
  type: 'card' as const,
  name: 'Exemplo de cartão',
  role: 'conteúdo de demonstração',
  text: 'Este texto ocupa o lugar de uma avaliação para conferir a tipografia, o avatar de iniciais e a altura do cartão. Não é a fala de ninguém.',
};

/* Fixtures de quantidade. Textos de comprimentos bem diferentes de
   propósito: é o caso que o desenho precisa aguentar sem cortar nada. */
const TEXTOS = [
  'Texto curto. 🙂',
  'Um texto de tamanho médio, com duas linhas mais ou menos, para conferir como o cartão se comporta quando o conteúdo não é nem curto nem longo.',
  'Um texto claramente mais longo que os outros, escrito para forçar o pior caso do carrossel: vários parágrafos de altura num item só, enquanto o vizinho tem uma linha. O cartão precisa mostrar tudo, sem reticências e sem recorte, e os outros acompanham a altura em vez de deixar o trilho torto. Emojis também entram aqui 👋 e precisam sair inteiros.',
  'Texto médio com emoji no meio 💚 para conferir a pilha de fontes.',
  'Outro curto.',
];

const NOMES = [
  'Ana Paula', 'Bruno', 'Carla Menezes', 'Diego', 'Elisa Fontes',
  'Felipe', 'Giovana Alves', 'Heitor', 'Isabela Cruz', 'João',
];

const fixture = (n: number) =>
  Array.from({ length: n }, (_, i) => ({
    type: 'card' as const,
    name: NOMES[i % NOMES.length]!,
    text: TEXTOS[i % TEXTOS.length]!,
    /* Uma parte com nota, outra sem: sem o campo, nenhuma estrela deve
       aparecer, e é isso que precisa ficar visível lado a lado. */
    rating: i % 3 === 0 ? 5 : i % 3 === 1 ? 4 : undefined,
    role: i % 4 === 0 ? 'dado de teste' : undefined,
    date: i % 4 === 1 ? 'março de 2026' : undefined,
  }));

const QUANTIDADES = [0, 1, 2, 3, 6, 10];
---

{
  page === 'componentes' && (
    <BaseLayout title="Componentes (dev)" description="Vitrine interna." noindex>
      <main class="dev">
        <p class="warn">
          <strong>Ambiente de desenvolvimento.</strong> Esta página não é gerada
          no build de produção. Todo o conteúdo abaixo é demonstração de layout:
          nenhuma avaliação, nome ou resultado aqui é real.
        </p>

        <h1>Componentes</h1>

        <h2>Ícones</h2>
        <p>Grade 24×24, traço 1.5, pontas redondas, <code>currentColor</code>.</p>
        <ul class="icons">
          {ICON_NAMES.map((name) => (
            <li>
              <Icon name={name} size="2rem" />
              <code>{name}</code>
            </li>
          ))}
        </ul>

        <h2>Ícones no tamanho de uso</h2>
        <p>Todos herdam a cor e o tamanho do texto ao redor.</p>
        <ul class="icons small">
          {ICON_NAMES.map((name) => (
            <li>
              <Icon name={name} />
              <code>{name}</code>
            </li>
          ))}
        </ul>

        <p>
          As quantidades da seção de avaliações ficam em
          <a href="/dev/avaliacoes/"> /dev/avaliacoes/</a>.
        </p>
      </main>

      <ReviewsSection
        enabled
        title="Avaliação: conversa (demonstração)"
        subtitle="Formato type: phone. Conteúdo fictício, apenas para conferir o desenho."
        items={[demoConversa]}
      />

      <ReviewsSection
        enabled
        tone="default"
        title="Avaliação: cartão (demonstração)"
        subtitle="Formato type: card. Conteúdo fictício, apenas para conferir o desenho."
        items={[demoCartao, { ...demoCartao, name: 'Segundo exemplo', rating: 5 }]}
      />
    </BaseLayout>
  )
}

{
  page === 'avaliacoes' && (
    <BaseLayout
      title="Avaliações: quantidades (dev)"
      description="Vitrine interna."
      noindex
    >
      <main class="dev">
        <p class="warn">
          <strong>Ambiente de desenvolvimento.</strong> Esta página não é gerada
          no build de produção. Os dados abaixo são fixtures: nenhum nome, texto
          ou nota aqui é real, e nada disto vem do YAML de um produto.
        </p>
        <h1>Seção de avaliações por quantidade</h1>
        <p>
          A mesma peça com {QUANTIDADES.join(', ')} itens. Zero não renderiza
          nada, uma fica centrada, duas lado a lado, e daí em diante é
          carrossel. Não existe número máximo.
        </p>
      </main>

      {QUANTIDADES.map((n) => (
        <ReviewsSection
          enabled
          tone={n % 2 === 0 ? 'warm' : 'default'}
          title={`${n} avaliação(ões)`}
          subtitle={
            n === 0
              ? 'Nada deve ser renderizado abaixo, nem título.'
              : `Fixture com ${n} item(ns).`
          }
          items={fixture(n)}
        />
      ))}
    </BaseLayout>
  )
}

<style>
  .dev {
    max-width: 60rem;
    margin: 0 auto;
    padding: var(--s-8) var(--s-5);
  }

  .warn {
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    padding: var(--s-4);
    color: var(--color-muted);
    margin-bottom: var(--s-7);
  }

  h2 {
    margin-top: var(--s-8);
  }

  .icons {
    list-style: none;
    padding: 0;
    margin: var(--s-5) 0 0;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
  }

  .icons li {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-primary);
  }

  .icons code {
    font-size: var(--t--1);
    color: var(--color-muted);
  }
</style>

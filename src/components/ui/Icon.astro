---
/**
 * Ícone da BookGo.
 *
 * Único lugar do projeto com viewBox e atributos de traço: a grade
 * (24×24, traço 1.5, pontas redondas) é definida aqui e mais em lugar
 * nenhum. Trocar a espessura de todos os ícones é mudar uma linha.
 *
 * Herda a cor por `currentColor` e o tamanho por `em`, então um ícone ao
 * lado de texto acompanha a tipografia sem ajuste manual.
 *
 * Acessibilidade: decorativo por padrão (`aria-hidden`). Passe `label`
 * apenas quando o ícone for a única fonte da informação — o que, no site,
 * não acontece hoje: todo ícone acompanha um texto que já diz o mesmo.
 */
import { ICONS, type IconName } from '../../lib/icons';

interface Props {
  name: IconName;
  /** Aceita qualquer unidade CSS. Padrão: acompanha o tamanho da fonte. */
  size?: string;
  class?: string;
  /** Quando presente, o ícone vira imagem com nome acessível. */
  label?: string;
}

const { name, size, class: className, label } = Astro.props;

const body = ICONS[name];
if (!body) throw new Error(`Ícone desconhecido: "${name}". Ver src/lib/icons.ts.`);

const title = label ? `<title>${label}</title>` : '';
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  style={size ? `--icon-size:${size}` : undefined}
  set:html={title + body}
/>

<style>
  .icon {
    width: var(--icon-size, 1em);
    height: var(--icon-size, 1em);
    /* Impede que o ícone encolha dentro de flex/grid apertado. */
    flex: none;
  }
</style>

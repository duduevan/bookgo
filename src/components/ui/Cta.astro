---
/**
 * Botão de checkout.
 *
 * Quando `href` é null (checkout ainda não configurado) o CTA é renderizado,
 * mas não vira link — nunca aponta para uma URL inválida.
 *
 * O estado pendente NÃO é sinalizado por transparência: baixar a opacidade
 * derrubava o contraste para 2,2:1 e fazia o botão principal parecer
 * quebrado. Agora o botão mantém preenchimento e contraste plenos, e a
 * condição é comunicada por `aria-disabled`, cursor e a nota abaixo.
 */
interface Props {
  href: string | null;
  label: string;
  variant?: 'primary' | 'inverse';
  size?: 'md' | 'lg';
  block?: boolean;
  /**
   * O que o botão faz, e não como ele parece.
   *
   * `buy` leva ao checkout e é o único que carrega `checkout_click`.
   * `continue` leva a outro ponto da própria página (a oferta), e por isso
   * não dispara evento de compra: um clique que só rola a página não é
   * intenção de pagamento, e contá-lo como tal misturaria dois momentos do
   * funil no mesmo número.
   *
   * O valor sai no HTML como `data-cta`, para a conferência do site
   * publicado poder afirmar a regra em vez de confiar na leitura do código.
   */
  kind?: 'buy' | 'continue';
  /**
   * Atributos `data-*` do evento de clique. Vêm de `eventAttrs()`, que
   * devolve `{}` com o tracking desligado — então hoje nada é emitido.
   */
  track?: Record<string, string>;
}

const {
  href,
  label,
  variant = 'primary',
  size = 'md',
  block = false,
  kind = 'buy',
  track = {},
} = Astro.props;

const classes = ['cta', `v-${variant}`, `s-${size}`, block ? 'block' : ''];

/**
 * O botão de compra abre o checkout em nova aba.
 *
 * O checkout é domínio de terceiro (a Kiwify), e a aba nova preserva a
 * landing page inteira atrás dele: quem abre o pagamento, hesita e quer
 * reler a garantia ou o que está incluído volta para a página no estado
 * em que a deixou, em vez de depender do botão de voltar do navegador
 * para reconstruí-la. Em campanha paga isso é a diferença entre recuperar
 * a pessoa e perdê-la.
 *
 * `noopener` é obrigatório junto: sem ele, a página aberta ganha
 * referência à nossa pelo `window.opener`.
 *
 * Só vale para `buy` e para link externo. O de continuidade rola a própria
 * página, e abrir uma aba para ir a uma âncora interna seria absurdo.
 */
const externo = !!href && /^https?:\/\//.test(href);
const novaAba = kind === 'buy' && externo;
---

<div class:list={['wrap', { block }]}>
  {
    href ? (
      <a
        class:list={classes}
        href={href}
        data-cta={kind}
        target={novaAba ? '_blank' : undefined}
        rel={novaAba ? 'noopener' : undefined}
        {...track}
      >
        {label}
      </a>
    ) : (
      <span
        class:list={[...classes, 'pending']}
        role="link"
        aria-disabled="true"
        data-cta={kind}
      >
        {label}
      </span>
    )
  }
  {
    !href && (
      <p class="pending-note">
        <span class="dot" aria-hidden="true" />
        Checkout em configuração.
      </p>
    )
  }
</div>

<style>
  .wrap.block {
    width: 100%;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--s-2);
    font-weight: 620;
    letter-spacing: 0.01em;
    line-height: 1.2;
    border-radius: var(--radius-pill);
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      background-color 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .s-md {
    padding: 0.85rem 1.6rem;
    font-size: var(--t-0);
  }

  .s-lg {
    padding: 1.05rem 2rem;
    font-size: var(--t-1);
  }

  .cta.block {
    display: flex;
    width: 100%;
  }

  .v-primary {
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-sm);
  }

  a.v-primary:hover {
    background: var(--color-primary-dark);
    color: var(--color-on-primary);
    transform: translateY(-1px);
    box-shadow: var(--shadow);
  }

  .v-inverse {
    background: var(--color-surface-raised);
    color: var(--color-primary);
  }

  a.v-inverse:hover {
    color: var(--color-primary-dark);
    transform: translateY(-1px);
    box-shadow: var(--shadow);
  }

  /* Sem opacity: o contraste do texto sobre o botão é preservado.
     A borda tracejada e o cursor comunicam que ainda não é clicável. */
  .pending {
    cursor: not-allowed;
    border-style: dashed;
    border-color: color-mix(in srgb, var(--color-on-primary) 55%, transparent);
  }

  .v-inverse.pending {
    border-color: color-mix(in srgb, var(--color-primary) 45%, transparent);
  }

  .pending-note {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-3);
    font-size: var(--t--1);
    color: inherit;
    opacity: 0.82;
  }

  .dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentColor;
    flex: none;
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta {
      transition: none;
    }

    a.cta:hover {
      transform: none;
    }
  }
</style>

---
/**
 * CTA em formato pill, com círculo e seta opcionais.
 * Usado no site institucional; o checkout das LPs usa Cta.astro,
 * que precisa lidar com URL ainda não configurada.
 */
import Icon from './Icon.astro';

interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'inverse' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  arrow?: boolean;
  class?: string;
}

const {
  href,
  label,
  variant = 'primary',
  size = 'md',
  arrow = false,
  class: className,
} = Astro.props;
---

<a
  class:list={['pill', `v-${variant}`, `s-${size}`, { 'has-arrow': arrow }, className]}
  href={href}
>
  <span>{label}</span>
  {
    arrow && (
      <span class="circle" aria-hidden="true">
        <Icon name="arrow-up-right" />
      </span>
    )
  }
</a>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-weight: var(--w-semibold);
    letter-spacing: -0.006em;
    line-height: 1;
    border: 1px solid transparent;
    white-space: nowrap;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .pill:hover {
    transform: translateY(-1px);
  }

  .s-sm {
    padding: 0.5rem 1rem;
    font-size: var(--t--1);
  }

  .s-md {
    padding: 0.7rem 1.25rem;
    font-size: var(--t-0);
  }

  .s-lg {
    padding: 0.95rem 1.5rem;
    font-size: var(--t-1);
  }

  .s-md.has-arrow,
  .s-lg.has-arrow {
    padding-right: 0.5rem;
  }

  .s-sm.has-arrow {
    padding-right: 0.375rem;
  }

  .v-primary {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .v-primary:hover {
    background: var(--color-primary-dark);
    color: var(--color-on-primary);
  }

  .v-inverse {
    background: #ffffff;
    color: var(--color-primary);
  }

  .v-inverse:hover {
    background: #ffffff;
    color: var(--color-primary-dark);
  }

  .v-outline {
    border-color: var(--color-border);
    color: var(--color-text);
    background: transparent;
  }

  .v-outline:hover {
    border-color: var(--color-text);
    color: var(--color-text);
  }

  .circle {
    display: grid;
    place-items: center;
    border-radius: 50%;
    flex: none;
    transition: transform var(--dur) var(--ease);
  }

  .s-sm .circle {
    width: 1.5rem;
    height: 1.5rem;
  }

  .s-md .circle {
    width: 1.875rem;
    height: 1.875rem;
  }

  .s-lg .circle {
    width: 2.25rem;
    height: 2.25rem;
  }

  .circle :global(.icon) {
    --icon-size: 55%;
  }

  .v-primary .circle {
    background: color-mix(in srgb, var(--color-on-primary) 18%, transparent);
  }

  .v-inverse .circle {
    background: var(--color-primary-soft);
  }

  .v-outline .circle {
    background: var(--color-surface);
  }

  .pill:hover .circle {
    transform: translate(1px, -1px);
  }
</style>

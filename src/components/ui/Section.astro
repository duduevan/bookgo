---
/**
 * Seção da landing page e do site.
 *
 * `layout="split"` existe para o problema mais visível da LP: seções cujo
 * cabeçalho é curto e o corpo é longo ficavam com o título sozinho à
 * esquerda e meia página vazia à direita. No split o cabeçalho ocupa uma
 * coluna estreita própria e o corpo ocupa a larga ao lado — a mancha fecha
 * e a leitura ganha direção.
 */
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  tone?: 'default' | 'warm' | 'soft' | 'accent';
  align?: 'start' | 'center';
  narrow?: boolean;
  layout?: 'stack' | 'split';
  /**
   * Largura da coluna do cabeçalho no `split`.
   *
   * A régua estreita padrão serve a títulos de três ou quatro palavras.
   * Um título longo nela quebra em sete linhas curtas e alonga a coluna
   * muito além do corpo ao lado, que é o vazio que o split existe para
   * evitar. Nesses casos, alargar o cabeçalho fecha a mancha.
   */
  headWidth?: string;
}

const {
  id,
  eyebrow,
  title,
  intro,
  tone = 'default',
  align = 'start',
  narrow = false,
  layout = 'stack',
  headWidth,
} = Astro.props;
---

<section id={id} class:list={['section', `tone-${tone}`, `align-${align}`]}>
  <div
    class:list={['container', `l-${layout}`]}
    style={headWidth ? `--split-head:${headWidth};--split-gap:var(--s-7)` : undefined}
  >
    {
      (eyebrow || title || intro) && (
        <header class="head">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {title && <h2>{title}</h2>}
          {intro && <p class="lede">{intro}</p>}
        </header>
      )
    }
    <div class:list={['body', { narrow }]}>
      <slot />
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-y);
  }

  .tone-warm {
    background: var(--color-surface);
  }

  .tone-soft {
    background: var(--color-primary-soft);
  }

  .tone-accent {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .tone-accent :global(h2) {
    color: var(--color-on-primary);
  }

  .tone-accent .lede {
    color: color-mix(in srgb, var(--color-on-primary) 82%, transparent);
  }

  .body.narrow {
    max-width: var(--w-text);
  }

  @media (min-width: 62rem) {
    .l-split {
      display: grid;
      grid-template-columns: minmax(0, var(--split-head, 19rem)) minmax(0, 1fr);
      gap: var(--split-gap, var(--s-9));
      align-items: start;
    }

    .l-split .head {
      margin-bottom: 0;
      /* Acompanha a rolagem do corpo longo sem virar coluna sticky de
         verdade: o deslocamento é só óptico, para o título não parecer
         ancorado no topo absoluto. */
      padding-top: var(--s-2);
    }
  }

  .head {
    max-width: var(--w-text);
    margin-bottom: var(--s-7);
  }

  .head > * + * {
    margin-top: var(--s-3);
  }

  .align-center .head {
    margin-inline: auto;
    text-align: center;
  }

  .align-center .body.narrow {
    margin-inline: auto;
  }
</style>

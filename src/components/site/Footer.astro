---
import { SITE, FOOTER, NAV } from '../../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div>
      <p class="wordmark">{SITE.name}</p>
      <p class="note">{FOOTER.note}</p>
    </div>
    <nav aria-label="Rodapé">
      <ul>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <p class="copy">© {year} {FOOTER.legalName}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--c-line);
    background: var(--c-surface-warm);
    padding-block: var(--s-8);
    margin-top: auto;
  }

  .inner {
    display: grid;
    gap: var(--s-5);
  }

  .wordmark {
    font-size: var(--t-1);
    font-weight: 680;
    letter-spacing: -0.03em;
  }

  .note,
  .copy {
    font-size: var(--t--1);
    color: var(--c-muted);
    max-width: 34rem;
  }

  .note {
    margin-top: var(--s-2);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-size: var(--t--1);
    color: var(--c-ink-2);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--c-accent);
  }

  @media (min-width: 48rem) {
    .inner {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .copy {
      grid-column: 1 / -1;
      padding-top: var(--s-4);
      border-top: 1px solid var(--c-line);
    }
  }
</style>

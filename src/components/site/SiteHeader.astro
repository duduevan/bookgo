---
import { NAV, NAV_CTA } from '../../config/site';
import Logo from './Logo.astro';
import PillButton from '../ui/PillButton.astro';

interface Props {
  /** Sobre fundo escuro o logo e os links invertem. */
  onDark?: boolean;
}

const { onDark = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href.startsWith('/') && !href.includes('#') && path.startsWith(href);
---

<header class:list={['site-header', { 'on-dark': onDark }]}>
  <div class="container bar">
    <a class="brand" href="/" aria-label="BookGo — página inicial">
      <Logo variant={onDark ? 'white' : 'blue'} height={26} />
    </a>

    <nav class="desktop" aria-label="Principal">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <PillButton
        href={NAV_CTA.href}
        label={NAV_CTA.label}
        size="sm"
        variant={onDark ? 'inverse' : 'primary'}
      />
    </nav>

    {/* Mobile: disclosure nativo, sem JavaScript. */}
    <details class="mobile">
      <summary aria-label="Abrir menu">
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </summary>
      <nav class="panel" aria-label="Principal (mobile)">
        <ul>
          {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
        <PillButton href={NAV_CTA.href} label={NAV_CTA.label} size="md" arrow />
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    min-height: 4.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  /* ── Desktop ─────────────────────────────────────────────── */
  .desktop {
    display: none;
    align-items: center;
    gap: var(--s-7);
  }

  .desktop ul {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .desktop a {
    font-size: var(--t-0);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .desktop a:hover,
  .desktop a[aria-current='page'] {
    color: var(--color-text);
  }

  .on-dark .desktop a {
    color: color-mix(in srgb, #ffffff 76%, transparent);
  }

  .on-dark .desktop a:hover,
  .on-dark .desktop a[aria-current='page'] {
    color: #ffffff;
  }

  /* ── Mobile ──────────────────────────────────────────────── */
  .mobile summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.625rem;
    border-radius: var(--radius-pill);
    cursor: pointer;
    list-style: none;
  }

  .mobile summary::-webkit-details-marker {
    display: none;
  }

  .bars {
    display: grid;
    gap: 5px;
    width: 1.125rem;
  }

  .bars i {
    display: block;
    height: 1.5px;
    border-radius: 2px;
    background: var(--color-text);
    transition: transform var(--dur) var(--ease);
  }

  .on-dark .bars i {
    background: #ffffff;
  }

  .mobile[open] .bars i:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .mobile[open] .bars i:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .panel {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    margin-top: var(--s-3);
    padding: var(--s-5);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .panel ul {
    list-style: none;
    margin: 0 0 var(--s-5);
    padding: 0;
    display: grid;
    gap: var(--s-1);
  }

  .panel a {
    display: block;
    padding: var(--s-3) 0;
    font-size: var(--t-2);
    letter-spacing: var(--tr-title);
    color: var(--color-text);
    text-decoration: none;
  }

  @media (min-width: 56rem) {
    .desktop {
      display: flex;
    }

    .mobile {
      display: none;
    }
  }
</style>

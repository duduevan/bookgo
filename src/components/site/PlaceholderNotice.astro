---
/**
 * Aviso de documento legal incompleto.
 *
 * Em vez de dizer genericamente "há texto a preencher", lista **o que**
 * falta, lido do registro em `src/config/legal.ts`. Quem abre a página sabe
 * exatamente o que está pendente, e quem for completar não precisa caçar
 * marcações no meio do texto.
 *
 * Sem pendência, não renderiza nada.
 */
interface Props {
  pending: string[];
}

const { pending } = Astro.props;
---

{
  pending.length > 0 && (
    <aside class="notice" role="note">
      <p class="head">
        <strong>Documento em preparação.</strong> Este texto descreve
        corretamente o que o site faz hoje, mas ainda depende dos dados
        abaixo para valer como documento público. Enquanto isso, a página não
        é indexada por buscadores nem consta do sitemap.
      </p>
      <ul>
        {pending.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </aside>
  )
}

<style>
  .notice {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-5);
    margin-bottom: var(--s-7);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    font-size: var(--t--1);
    color: var(--color-muted);
    max-width: var(--w-prose);
  }

  .head {
    margin: 0;
  }

  strong {
    color: var(--color-text);
  }

  ul {
    margin: 0;
    padding-left: var(--s-5);
    display: grid;
    gap: var(--s-2);
  }
</style>

---
/**
 * Depoimento em cartão: a forma sóbria, para texto corrido.
 *
 * Semântica de citação real (`figure` + `blockquote` + `figcaption`), não um
 * cartão genérico: quem usa leitor de tela ouve que aquilo é a fala de uma
 * pessoa, e não texto da BookGo.
 *
 * Sem `<style>` próprio de propósito — ver src/styles/testimonials.css.ts.
 */
import { initialsOf } from '../../lib/testimonials';

interface Props {
  name: string;
  role?: string;
  avatar?: string;
  text: string;
}

const { name, role, avatar, text } = Astro.props;
---

<figure class="tst-card">
  <blockquote class="tst-quote">{text}</blockquote>
  <figcaption class="tst-cap">
    {
      avatar ? (
        <img class="tst-avatar" src={avatar} alt="" width="40" height="40" loading="lazy" decoding="async" />
      ) : (
        /* Sem foto, as iniciais do nome. Derivar do que existe é honesto;
           gerar um rosto que não existe não seria. */
        <span class="tst-avatar tst-initials" aria-hidden="true">{initialsOf(name)}</span>
      )
    }
    <span class="tst-who">
      <span class="tst-name">{name}</span>
      {role && <span class="tst-role">{role}</span>}
    </span>
  </figcaption>
</figure>

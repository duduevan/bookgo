---
/**
 * Seção de depoimentos da LP.
 *
 * Renderiza **nada** com `enabled: false` — nem título, nem espaço, nem uma
 * linha de CSS a mais na página. É esse o estado hoje: não existe depoimento
 * real autorizado, então a LP sai idêntica à de antes deste componente.
 *
 * O formato (cartão ou conversa) é decisão do conteúdo, item a item.
 *
 * O CSS das três peças é emitido daqui, uma vez, **dentro** da guarda: é o
 * que garante o custo zero com a seção desligada. Ver
 * src/styles/testimonials.css.ts.
 */
import Section from '../ui/Section.astro';
import TestimonialCard from './TestimonialCard.astro';
import PhoneTestimonial from './PhoneTestimonial.astro';
import { TESTIMONIALS_CSS } from '../../styles/testimonials.css';

interface CardItem {
  type: 'card';
  name: string;
  role?: string;
  avatar?: string;
  text: string;
}

interface PhoneItem {
  type: 'phone';
  name: string;
  avatar?: string;
  status?: string;
  messages: Array<{
    side: 'incoming' | 'outgoing';
    text: string;
    time?: string;
    read?: boolean;
  }>;
}

interface Props {
  enabled: boolean;
  /**
   * Conteúdo de demonstração: renderiza uma tarja **visível** dizendo que
   * aquilo é exemplo de layout.
   *
   * A tarja é deliberada e não deve ser escondida. Um aviso que mora só no
   * código deixa de existir exatamente quando mais importa — na hora em que
   * alguém publica sem lembrar. Assim, publicar por engano fica óbvio na
   * própria página.
   */
  demo?: boolean;
  title?: string;
  intro?: string;
  items: Array<CardItem | PhoneItem>;
  tone?: 'default' | 'warm' | 'soft';
}

const { enabled, demo = false, title, intro, items, tone = 'warm' } = Astro.props;

const show = enabled && items.length > 0;

/* Conversas ocupam largura própria; cartões vivem melhor em grade. Uma
   lista só de conversas não deve virar uma grade de três colunas apertadas. */
const onlyPhones = items.every((i) => i.type === 'phone');
---

{
  show && (
    <Section tone={tone} title={title} intro={intro} align={onlyPhones ? 'center' : 'start'}>
      <style is:inline set:html={TESTIMONIALS_CSS} />
      {/* Identificação discreta, no lugar da tarja de alerta que havia
          antes. Continua visível na página, que é o ponto: um aviso que
          mora só no código deixa de existir quando alguém publica sem
          lembrar. Mas caixa de alerta acima de uma seção de conversas
          derruba o que a seção tinha de bom, e um rótulo editorial
          identifica igual sem competir com o desenho. */}
      {demo && <p class="tst-ilustrativa">Conversas ilustrativas</p>}
      <div class:list={['tst-items', { 'tst-phones': onlyPhones }]}>
        {items.map((item) =>
          item.type === 'phone' ? (
            <PhoneTestimonial
              name={item.name}
              avatar={item.avatar}
              status={item.status}
              messages={item.messages}
            />
          ) : (
            <TestimonialCard
              name={item.name}
              role={item.role}
              avatar={item.avatar}
              text={item.text}
            />
          )
        )}
      </div>
    </Section>
  )
}


---
/** Lista simples reutilizada em problema, público-alvo e itens da oferta. */
import Icon from '../ui/Icon.astro';

interface Props {
  items: string[];
  /** `minus` é a exclusão neutra de "para quem não é" — nunca um X. */
  marker?: 'check' | 'minus' | 'dot' | 'dash';
  columns?: boolean;
}

const { items, marker = 'dot', columns = false } = Astro.props;
---

<ul class:list={['list', `m-${marker}`, { columns }]}>
  {
    items.map((item) => (
      <li>
        {marker === 'check' || marker === 'minus' ? (
          <Icon name={marker} class="bullet" />
        ) : (
          <span class="mark" aria-hidden="true" />
        )}
        <span>{item}</span>
      </li>
    ))
  }
</ul>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-4);
  }

  li {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: var(--s-3);
    align-items: start;
    color: var(--color-muted);
  }

  li :global(.bullet) {
    --icon-size: 1.25rem;
    margin-top: 0.15em;
    color: var(--color-primary);
  }

  /* Exclusão é informação neutra, não alerta: fica no tom secundário. */
  .m-minus :global(.bullet) {
    color: var(--color-muted);
  }

  .mark {
    margin-top: 0.66em;
    height: 2px;
    border-radius: 2px;
    background: var(--color-border);
  }

  .m-dot .mark {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    margin-top: 0.62em;
    margin-left: 0.42rem;
    background: var(--color-muted);
  }

  @media (min-width: 46rem) {
    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-4) var(--s-7);
    }
  }
</style>

---
/**
 * Cartão de um material prático, para listagens fora da landing page.
 *
 * O componente não conhece produto nenhum: recebe a entrada da coleção e
 * lê dela nome, capa, categoria, preço e URL. Material novo aparece na
 * listagem por existir, sem ninguém escrever HTML.
 *
 * **Leva à landing page, nunca ao checkout.** Quem está na home ainda não
 * viu o que está incluso nem a garantia, e pular a LP cobraria a decisão
 * antes de a pessoa ter com o que decidir. Por isso o evento é
 * `product_click` e não `checkout_click`: contar como intenção de compra
 * um clique que apenas abre a página do produto misturaria dois momentos
 * do funil no mesmo número.
 *
 * A capa é a própria imagem do hero do produto. Sem o arquivo, o quadro
 * usa a paleta do material e continua sendo superfície intencional, em vez
 * de virar buraco na grade.
 */
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { productUrl, type Product } from '../../lib/content';
import { productImage } from '../../lib/product-images';
import { themeToStyle } from '../../lib/theme';
import { eventAttrs } from '../../lib/tracking';

interface Props {
  product: Product;
  /** Mostra o rótulo da categoria dentro do cartão. */
  showCategory?: boolean;
}

const { product, showCategory = false } = Astro.props;
const d = product.data;
const href = productUrl(d.slug);
const cover = productImage(d.slug, d.hero.image);

const track = eventAttrs('product_click', {
  product_slug: d.slug,
  product_name: d.name,
  placement: 'home_materiais',
});
---

<article class="card" style={themeToStyle(d.theme)} data-card>
  <div class="cover">
    {
      cover ? (
        <Image
          src={cover}
          alt=""
          widths={[320, 480, 640]}
          sizes="(min-width: 60rem) 20rem, calc(100vw - 2 * var(--gutter))"
          loading="lazy"
          decoding="async"
          quality={72}
        />
      ) : (
        <span class="cover-fallback" aria-hidden="true" />
      )
    }
  </div>

  <div class="body">
    {showCategory && <p class="kicker">{d.category.label}</p>}
    <h3>
      <a href={href} {...track}>
        <span class="overlay" />
        {d.name}
      </a>
    </h3>
    <p class="tagline">{d.tagline}</p>

    <p class="meta">
      <span class="price">{d.price.display}</span>
      <span>pagamento único</span>
    </p>

    <span class="go" aria-hidden="true">
      Conhecer o material
      <Icon name="arrow-right" class="u-arrow" />
    </span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .cover {
    aspect-ratio: 3 / 2;
    background: var(--color-primary-soft);
    overflow: hidden;
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Sem foto, a superfície é a paleta do próprio material. */
  .cover-fallback {
    display: block;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(
        120% 90% at 20% 10%,
        color-mix(in srgb, var(--color-primary) 24%, transparent),
        transparent 70%
      ),
      var(--color-primary-soft);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5);
    flex: 1;
  }

  .kicker {
    font-size: var(--t--1);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    font-weight: var(--w-semibold);
    color: var(--color-primary-dark);
  }

  h3 {
    font-size: var(--t-1);
    color: var(--color-text);
  }

  h3 a {
    color: inherit;
    text-decoration: none;
  }

  /* O cartão inteiro é a área de clique, e o link continua sendo um link
     só: nada de âncoras aninhadas nem de onclick no contêiner. */
  .overlay {
    position: absolute;
    inset: 0;
  }

  .tagline {
    color: var(--color-muted);
    font-size: var(--t-0);
    line-height: 1.55;
  }

  .meta {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    font-size: var(--t--1);
    color: var(--color-muted);
    margin-top: auto;
  }

  .price {
    font-size: var(--t-1);
    font-weight: var(--w-semibold);
    color: var(--color-text);
  }

  .go {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t--1);
    font-weight: var(--w-semibold);
    color: var(--color-primary-dark);
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--color-primary) 40%, var(--color-border));
    box-shadow: var(--shadow);
  }

  .card:has(a:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }
</style>

---
/**
 * Vitrine dos temas do material.
 *
 * **Por que não é a lista numerada.** `ModuleList` foi feito para módulos
 * de curso, onde a ordem é o produto: o 2 depende do 1. Uma coleção para
 * colorir não tem ordem, e a grade é o que comunica variedade, que é o
 * argumento desta seção.
 *
 * **Por que os dez desenhos não estão escritos.** A versão anterior
 * listava os dez de cada tema em texto corrido. Oito parágrafos densos,
 * um atrás do outro, que ninguém lê e que empurravam a oferta para muito
 * longe. O cartão agora mostra o traço em duas miniaturas reais e resume
 * o tema em uma linha: quem quer saber o que tem dentro olha o desenho,
 * não a enumeração.
 *
 * **Miniatura só quando existe.** Tema sem foto de página continua
 * inteiro, com o ícone no lugar das miniaturas. Desenhar uma amostra para
 * preencher o cartão seria inventar o conteúdo do arquivo.
 */
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { productImage } from '../../lib/product-images';

export interface ThemeItem {
  number: number;
  title: string;
  objective: string;
  icon?: string;
  blurb?: string;
  thumbs?: string[];
}

interface Props {
  slug: string;
  items: ThemeItem[];
  /** Ex.: "10 desenhos". Vem do YAML, nunca calculado aqui. */
  countLabel?: string;
}

const { slug, items, countLabel } = Astro.props;

const temas = items.map((t) => ({
  ...t,
  imagens: (t.thumbs ?? [])
    .map((src) => productImage(slug, src))
    .filter(Boolean)
    .slice(0, 3),
}));
---

<ul class="themes">
  {
    temas.map((t) => (
      <li class="theme">
        <div class="theme-head">
          <span class="theme-badge" aria-hidden="true">
            {t.icon ? <Icon name={t.icon} /> : <span class="theme-num">{t.number}</span>}
          </span>
          <h3 class="theme-title">{t.title}</h3>
          {countLabel && <span class="theme-count">{countLabel}</span>}
        </div>

        {t.blurb && <p class="theme-blurb">{t.blurb}</p>}

        {t.imagens.length > 0 && (
          <div class="theme-thumbs" aria-hidden="true">
            {t.imagens.map((img) => (
              <Image
                src={img!}
                alt=""
                widths={[160, 240]}
                sizes="8rem"
                loading="lazy"
                decoding="async"
                quality={72}
              />
            ))}
          </div>
        )}
      </li>
    ))
  }
</ul>

<style>
  .themes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    text-align: start;
  }

  .theme {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-4);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .theme-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .theme-badge {
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-primary-soft);
    color: var(--color-primary-dark);
  }

  .theme-badge :global(.icon) {
    --icon-size: 1.1rem;
  }

  .theme-num {
    font-size: var(--t--1);
    font-weight: var(--w-bold);
  }

  .theme-title {
    margin: 0;
    font-size: var(--t--1);
    line-height: 1.25;
    flex: 1 1 auto;
  }

  .theme-count {
    font-size: var(--t--3, 0.7rem);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--color-primary-dark);
    background: var(--color-primary-soft);
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .theme-blurb {
    margin: 0;
    font-size: var(--t--2);
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* As miniaturas ficam no pé do cartão e empurram a régua para baixo:
     o cartão termina no desenho, que é o que a pessoa veio ver. */
  .theme-thumbs {
    margin-top: auto;
    display: flex;
    gap: var(--s-2);
  }

  .theme-thumbs :global(img) {
    display: block;
    width: 100%;
    min-width: 0;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
  }
</style>

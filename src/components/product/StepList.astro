---
/**
 * Passos do método, como jornada.
 *
 * A versão anterior era uma grade 2x2 de blocos numerados: correta, mas o
 * número era só um marcador ao lado do texto, e nada dizia que os quatro
 * passos acontecem **em sequência**. Numa página que vende um método, a
 * ordem é o argumento.
 *
 * Agora o número é a estrutura: um trilho atravessa os quatro discos no
 * desktop, horizontal, e desce ao lado deles no mobile. O trilho é
 * `aria-hidden` e existe só no CSS — a ordem real já está no `<ol>`, que é
 * o que um leitor de tela anuncia.
 *
 * Sem JavaScript.
 */
interface Props {
  steps: Array<{ title: string; text: string }>;
}

const { steps } = Astro.props;
---

<ol class="steps" style={`--count:${steps.length}`}>
  {
    steps.map((step, index) => (
      <li>
        <span class="node" aria-hidden="true">
          <span class="num">{index + 1}</span>
        </span>
        <div class="body">
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  /* Disco e espaçamento como variáveis: o trilho é posicionado a partir
     deles, então crescer o número no desktop não exige recalcular o CSS do
     trilho em dois lugares. */
  .steps {
    --disco: 3rem;
    --passo-gap: var(--s-6);
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--passo-gap);
  }

  li {
    position: relative;
    display: grid;
    grid-template-columns: var(--disco) 1fr;
    gap: var(--s-4);
    align-items: start;
    text-align: left;
  }

  .node {
    position: relative;
    z-index: 1;
    width: var(--disco);
    height: var(--disco);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-surface-raised);
    border: 1px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
    box-shadow: var(--shadow-sm);
  }

  .num {
    font-size: var(--t-1);
    font-weight: 680;
    letter-spacing: -0.02em;
    color: var(--color-primary-dark);
    line-height: 1;
  }

  h3 {
    font-size: var(--t-1);
    margin-top: 0.55rem;
  }

  p {
    margin-top: var(--s-3);
    color: var(--color-muted);
    font-size: var(--t-0);
  }

  /* Trilho vertical no mobile: liga um disco ao seguinte, e some no último
     para a linha não terminar no vazio. */
  li::before {
    content: '';
    position: absolute;
    left: calc(var(--disco) / 2);
    top: var(--disco);
    bottom: calc(var(--passo-gap) * -1);
    width: 2px;
    transform: translateX(-1px);
    background: color-mix(in srgb, var(--color-primary) 24%, transparent);
  }

  li:last-child::before {
    display: none;
  }

  @media (min-width: 60rem) {
    /* No desktop a jornada é o argumento da seção, e estava discreta demais
       para isso: disco maior, número maior e mais ar entre os passos. */
    .steps {
      --disco: 3.75rem;
      --passo-gap: var(--s-7);
      grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    }

    li {
      grid-template-columns: 1fr;
      gap: var(--s-5);
      text-align: center;
      justify-items: center;
      /* Sem isto, o passo mais alto define a altura da linha e os outros
         distribuem a sobra: os quatro discos param em alturas diferentes e
         a jornada deixa de ler como uma sequência. */
      align-content: start;
    }

    /* Espaço de duas linhas para todos os títulos, para que os parágrafos
       comecem na mesma altura mesmo quando só um deles quebra. */
    h3 {
      min-height: 2lh;
    }

    .node {
      background: var(--color-primary-soft);
      border-color: color-mix(in srgb, var(--color-primary) 42%, transparent);
    }

    .num {
      font-size: var(--t-2);
    }

    h3 {
      font-size: var(--t-2);
    }

    /* No desktop o trilho vira horizontal e liga um disco ao seguinte.
       A borda direita precisa alcançar o centro da próxima coluna: meia
       largura de coluna mais o gap. Parar na borda deixava um vão visível
       entre o fim do trilho e o disco de destino. */
    li::before {
      left: 50%;
      right: calc(-50% - var(--passo-gap));
      top: calc(var(--disco) / 2);
      bottom: auto;
      width: auto;
      height: 2px;
      transform: translateY(-1px);
    }

    .body {
      max-width: 26ch;
    }

    h3 {
      margin-top: 0;
    }
  }
</style>

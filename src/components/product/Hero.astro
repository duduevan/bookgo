---
import Cta from '../ui/Cta.astro';

interface Props {
  headline: string;
  subheadline: string;
  highlights: string[];
  ctaLabel: string;
  ctaHref: string | null;
  price: string;
}

const { headline, subheadline, highlights, ctaLabel, ctaHref, price } =
  Astro.props;
---

<section class="hero">
  <div class="art" aria-hidden="true">
    <span class="blob b1"></span>
    <span class="blob b2"></span>
  </div>
  <div class="container">
    <div class="inner">
    <h1>{headline}</h1>
    <p class="sub">{subheadline}</p>

    <div class="action">
      <Cta href={ctaHref} label={ctaLabel} size="lg" />
      <p class="price">{price} · pagamento único</p>
    </div>

    {
      highlights.length > 0 && (
        <ul class="highlights">
          {highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3.5rem, 2.2rem + 6vw, 7rem);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  /* Ambientação abstrata com as cores do próprio produto — nenhuma cor
     literal aqui, só os papéis do tema. */
  .art {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .blob {
    position: absolute;
    aspect-ratio: 1;
    border-radius: 50%;
    filter: blur(0.5px);
  }

  .b1 {
    width: min(44rem, 90vw);
    right: -12%;
    top: -34%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-primary) 16%, transparent) 0%,
      transparent 68%
    );
  }

  .b2 {
    width: min(26rem, 62vw);
    right: 6%;
    bottom: -32%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 18%, transparent) 0%,
      transparent 66%
    );
  }

  .inner {
    max-width: 52rem;
  }

  h1 {
    /* Menor que o display institucional: a headline do produto é longa e
       precisa caber em poucas linhas sem dominar a dobra. */
    font-size: var(--t-4);
    max-width: 19ch;
  }

  .sub {
    margin-top: var(--s-5);
    font-size: var(--t-1);
    color: var(--color-muted);
    max-width: 54ch;
  }

  .action {
    margin-top: var(--s-7);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-5);
  }

  .price {
    font-size: var(--t-0);
    color: var(--color-muted);
  }

  .highlights {
    margin-top: var(--s-7);
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
    font-size: var(--t--1);
    color: var(--color-muted);
  }

  .highlights li {
    display: flex;
    align-items: flex-start;
    gap: var(--s-2);
  }

  .highlights li::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    margin-top: 0.55em;
    border-radius: 50%;
    background: var(--color-primary);
    flex: none;
  }
</style>

---
/**
 * Hero da landing page.
 *
 * Composição em duas colunas no desktop. A versão anterior era uma coluna de
 * texto alinhada à esquerda com metade da dobra vazia à direita — o bloco
 * não tinha contrapeso e a página começava parecendo montada, não desenhada.
 *
 * A coluna da direita é um objeto composto, não um espaço reservado: o
 * quadro da imagem e, sobre ele, um cartão com os reforços do produto. Os
 * reforços saíram de baixo do CTA, onde flutuavam soltos — agora eles são o
 * contrapeso visual e continuam sendo a mesma informação.
 *
 * **Sem a imagem o quadro não vira buraco.** Ele usa a ambientação em
 * gradiente da própria paleta do produto e continua sendo uma superfície
 * intencional. Quando o arquivo chegar, entra no mesmo lugar sem mudar o
 * layout: o quadro já tem proporção fixa, então nada se desloca.
 */
import { Image } from 'astro:assets';
import Cta from '../ui/Cta.astro';
import Icon from '../ui/Icon.astro';
import type { IconName } from '../../lib/icons';

interface Highlight {
  text: string;
  icon?: IconName;
}

interface Props {
  eyebrow?: string;
  headline: string;
  subheadline: string;
  highlights: Highlight[];
  ctaLabel: string;
  ctaHref: string | null;
  price: string;
  image?: ImageMetadata;
  imageAlt?: string;
  track?: Record<string, string>;
}

const {
  eyebrow,
  headline,
  subheadline,
  highlights,
  ctaLabel,
  ctaHref,
  price,
  image,
  imageAlt,
  track = {},
} = Astro.props;
---

<section class="hero">
  <div class="art" aria-hidden="true">
    <span class="blob b1"></span>
    <span class="blob b2"></span>
  </div>

  <div class="container grid">
    <div class="copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{headline}</h1>
      <p class="sub">{subheadline}</p>

      <div class="action">
        <Cta href={ctaHref} label={ctaLabel} size="lg" track={track} />
        <p class="price">
          <strong>{price}</strong>
          <span>pagamento único</span>
        </p>
      </div>
    </div>

    <div class="media">
      <div class:list={['frame', { empty: !image }]}>
        {
          image && (
            /* Elemento de LCP: carrega cedo, com prioridade e dimensões
               reais já reservadas. */
            <Image
              src={image}
              alt={imageAlt ?? ''}
              widths={[520, 760, 1040]}
              sizes="(min-width: 62rem) 42vw, 100vw"
              loading="eager"
              fetchpriority="high"
              quality={78}
            />
          )
        }
      </div>

      {
        highlights.length > 0 && (
          <ul class="card">
            {highlights.map((item) => (
              <li>
                {item.icon && <Icon name={item.icon} />}
                <span>{item.text}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 1.8rem + 5.5vw, 6rem);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  /* Ambientação abstrata com a paleta do próprio produto. Nenhuma cor
     literal — só os papéis do tema. */
  .art {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .blob {
    position: absolute;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .b1 {
    width: min(44rem, 90vw);
    right: -14%;
    top: -38%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-primary) 15%, transparent) 0%,
      transparent 68%
    );
  }

  .b2 {
    width: min(26rem, 62vw);
    left: -10%;
    bottom: -30%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 15%, transparent) 0%,
      transparent 66%
    );
  }

  .grid {
    display: grid;
    gap: var(--s-8);
    align-items: center;
  }

  .eyebrow {
    font-size: var(--t--1);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    font-weight: var(--w-semibold);
    color: var(--color-primary-dark);
    margin-bottom: var(--s-4);
  }

  h1 {
    font-size: var(--t-4);
    max-width: 20ch;
    text-wrap: balance;
  }

  .sub {
    margin-top: var(--s-5);
    font-size: var(--t-1);
    color: var(--color-muted);
    max-width: 46ch;
  }

  .action {
    margin-top: var(--s-7);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-5);
  }

  /* O preço ganha peso próprio em vez de virar mais uma linha cinza ao
     lado do botão. */
  .price {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .price strong {
    font-size: var(--t-1);
    font-weight: var(--w-semibold);
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .price span {
    font-size: var(--t--1);
    color: var(--color-muted);
  }

  /* ── Coluna visual ───────────────────────────────────────── */

  .media {
    position: relative;
  }

  .frame {
    border-radius: var(--radius-xl);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Sem imagem, o quadro é uma superfície tratada: gradiente da paleta do
     produto e uma trama fina. Continua lendo como decisão de design, não
     como espaço que sobrou. */
  .frame.empty {
    position: relative;
    background:
      radial-gradient(
        110% 80% at 18% 6%,
        color-mix(in srgb, var(--color-surface-raised) 45%, transparent) 0%,
        transparent 60%
      ),
      linear-gradient(
        155deg,
        color-mix(in srgb, var(--color-primary) 34%, var(--color-surface-raised)) 0%,
        color-mix(in srgb, var(--color-accent) 26%, var(--color-surface-raised)) 100%
      );
  }

  .frame.empty::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--color-text) 6%, transparent) 0 1px,
      transparent 1px 13px
    );
  }

  .card {
    list-style: none;
    margin: 0;
    padding: var(--s-5);
    display: grid;
    gap: var(--s-4);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .card li {
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
    font-size: var(--t--1);
    color: var(--color-text);
    line-height: 1.45;
  }

  .card :global(.icon) {
    --icon-size: 1.25rem;
    color: var(--color-primary);
    margin-top: 0.05em;
  }

  /* No mobile o cartão segue o fluxo, logo abaixo do quadro. */
  .media .card {
    margin-top: var(--s-5);
  }

  /* Sem imagem, o quadro some no mobile. No desktop ele é contrapeso de
     composição; num celular vira uma tela inteira de rolagem que não
     entrega nada — aí sim seria buraco. */
  @media (max-width: 61.99rem) {
    .frame.empty {
      display: none;
    }

    .media .card {
      margin-top: 0;
    }
  }

  @media (min-width: 62rem) {
    .grid {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
      gap: var(--s-9);
    }

    h1 {
      max-width: 16ch;
    }

    .sub {
      max-width: 40ch;
    }

    /* O cartão sobrepõe o canto inferior do quadro: é o que transforma
       duas caixas empilhadas numa composição só. */
    .media .card {
      position: absolute;
      left: calc(var(--s-6) * -1);
      right: var(--s-8);
      bottom: calc(var(--s-6) * -1);
      margin-top: 0;
    }

    /* O cartão avança para fora do quadro; a coluna precisa desse respiro
       embaixo para ele não encostar na borda da seção. */
    .media {
      margin-bottom: var(--s-8);
    }
  }
</style>

---
/**
 * Rodapé da landing page.
 *
 * Assinatura institucional discreta: identifica quem publica e entrega os
 * links legais obrigatórios, sem oferecer saídas que concorram com a oferta.
 *
 * Traz apenas os documentos marcados com `inFooter` em src/config/legal.ts:
 * cada linha a mais aqui é uma saída da página de venda.
 */
import { SITE } from '../../config/site';
import { LEGAL_PAGES } from '../../config/legal';
import Logo from '../site/Logo.astro';

const year = new Date().getFullYear();
---

<footer class="lp-footer">
  <div class="container inner">
    <a class="signature" href="/" aria-label="BookGo, página inicial">
      <span>Um produto</span>
      <Logo variant="blue" height={18} loading="lazy" />
    </a>

    <nav aria-label="Links legais">
      <ul>
        {LEGAL_PAGES.filter((i) => i.inFooter).map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <p class="copy">© {year} {SITE.name}</p>
  </div>
</footer>

<style>
  .lp-footer {
    margin-top: auto;
    padding-block: var(--s-8);
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .inner {
    display: grid;
    gap: var(--s-5);
    align-items: center;
  }

  .signature {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    text-decoration: none;
    color: var(--color-muted);
    font-size: var(--t--1);
    justify-self: start;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-size: var(--t--1);
    color: var(--color-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .copy {
    font-size: var(--t--1);
    color: var(--color-muted);
  }

  @media (min-width: 52rem) {
    .inner {
      grid-template-columns: auto 1fr auto;
      gap: var(--s-7);
    }

    nav ul {
      justify-content: center;
    }
  }
</style>

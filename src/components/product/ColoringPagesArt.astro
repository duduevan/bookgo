---
/**
 * Composição do hero do Mundo de Colorir: três páginas empilhadas, com
 * desenho de traço, e lápis de cor ao lado.
 *
 * **Por que SVG inline e não foto.** As artes finais do material ainda não
 * existem, e um quadro vazio no hero seria um buraco no lugar mais
 * importante da página. Uma foto de banco de imagens com "criança
 * colorindo" também não serve: ela mostra a atividade, e não o produto.
 * Esta composição mostra exatamente o que a pessoa compra, no traço que o
 * material usa, e custa zero requisição.
 *
 * As três miniaturas usam a mesma régua da coleção: contorno preto
 * uniforme, fundo branco, forma cheia, nada de sombra. São o mesmo
 * desenho que estará no PDF, em escala menor.
 *
 * Quando as artes finais existirem, este componente sai e entra a foto do
 * material, no mesmo lugar e na mesma proporção.
 */
---

<div class="art" role="img" aria-label="Três páginas do material empilhadas, com desenhos de contorno preto, ao lado de lápis de cor">
  <svg viewBox="0 0 520 420" focusable="false" aria-hidden="true">
    {/* folha de trás */}
    <g transform="rotate(-8 150 220)">
      <rect x="60" y="70" width="200" height="270" rx="10" class="sheet" />
      {/* foguete */}
      <g class="ink" transform="translate(160 205) scale(1.25)">
        <path d="M0-52c14 14 22 32 22 52 0 12-3 23-8 33H-14c-5-10-8-21-8-33 0-20 8-38 22-52Z" />
        <circle cx="0" cy="-14" r="10" />
        <path d="M-22 15-38 33l16-2 4 14Z" />
        <path d="M22 15 38 33l-16-2-4 14Z" />
        <path d="M-11 33c4 10 7 16 11 22 4-6 7-12 11-22" />
      </g>
    </g>

    {/* folha do meio */}
    <g transform="rotate(5 270 210)">
      <rect x="170" y="50" width="200" height="270" rx="10" class="sheet" />
      {/* gatinho */}
      <g class="ink" transform="translate(270 190) scale(1.15)">
        <path d="M-34-18-24-46l20 14" />
        <path d="M34-18 24-46 4-32" />
        <path d="M0-34c22 0 38 16 38 36S22 38 0 38-38 22-38 2 -22-34 0-34Z" />
        <circle cx="-13" cy="-2" r="4" />
        <circle cx="13" cy="-2" r="4" />
        <path d="M-6 14c2 3 4 4 6 4s4-1 6-4" />
        <path d="M-30 10H-14" />
        <path d="M30 10H14" />
      </g>
    </g>

    {/* folha da frente */}
    <g transform="rotate(-2 380 230)">
      <rect x="280" y="80" width="200" height="270" rx="10" class="sheet" />
      {/* flor */}
      <g class="ink" transform="translate(380 200) scale(1.2)">
        <circle cx="0" cy="-14" r="12" />
        <circle cx="-24" cy="-2" r="12" />
        <circle cx="24" cy="-2" r="12" />
        <circle cx="-14" cy="22" r="12" />
        <circle cx="14" cy="22" r="12" />
        <circle cx="0" cy="4" r="11" />
        <path d="M0 40v34" />
        <path d="M0 58c-10 0-18-6-20-14 10-2 18 3 20 14Z" />
      </g>
    </g>

    {/* lápis de cor */}
    <g class="pencils">
      <g transform="rotate(16 70 360)">
        <rect x="30" y="330" width="130" height="17" rx="8" class="p1" />
        <path d="M30 338.5 10 338.5" class="tip" />
      </g>
      <g transform="rotate(10 70 384)">
        <rect x="40" y="356" width="130" height="17" rx="8" class="p2" />
        <path d="M40 364.5 20 364.5" class="tip" />
      </g>
      <g transform="rotate(4 70 408)">
        <rect x="50" y="382" width="130" height="17" rx="8" class="p3" />
        <path d="M50 390.5 30 390.5" class="tip" />
      </g>
    </g>
  </svg>
</div>

<style>
  .art {
    width: 100%;
    display: grid;
    place-items: center;
    padding: clamp(0.5rem, 0.2rem + 1.4vw, 1.5rem);
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  /* A folha é branca de verdade: é assim que o material sai da
     impressora, e é isso que a composição promete. */
  .sheet {
    fill: #ffffff;
    stroke: color-mix(in srgb, var(--color-text) 14%, transparent);
    stroke-width: 2;
    filter: drop-shadow(0 10px 24px rgb(0 0 0 / 0.12));
  }

  /* O traço do desenho segue a régua da coleção: contorno escuro
     uniforme, sem preenchimento, sem sombra. */
  .ink {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pencils rect {
    stroke: color-mix(in srgb, var(--color-text) 22%, transparent);
    stroke-width: 1.5;
  }

  .p1 {
    fill: var(--color-primary);
  }

  .p2 {
    fill: var(--color-accent);
  }

  .p3 {
    fill: var(--color-primary-dark);
  }

  .tip {
    stroke: color-mix(in srgb, var(--color-text) 55%, transparent);
    stroke-width: 5;
    stroke-linecap: round;
  }
</style>

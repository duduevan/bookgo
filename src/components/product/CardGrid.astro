---
/** Grade de cartões título + texto: pilares do método, benefícios, materiais. */
import Icon from '../ui/Icon.astro';
import type { IconName } from '../../lib/icons';

interface Props {
  /** `icon` é opcional item a item: um cartão sem ícone continua válido. */
  items: Array<{ title: string; text: string; icon?: IconName }>;
  variant?: 'card' | 'plain';
  min?: string;
  /**
   * Faz o primeiro cartão ocupar duas colunas nas telas largas.
   *
   * Resolve o órfão: cinco cartões numa grade de três deixavam uma lacuna
   * do tamanho de um cartão na segunda linha. Com o primeiro em dobro, a
   * contagem fecha (2+1 / 1+1+1) e a hierarquia ainda melhora — o benefício
   * de abertura ganha o peso que a ordem já sugeria.
   */
  feature?: boolean;
  /**
   * Colunas fixas nas telas largas. `auto` deixa a grade decidir pelo `min`,
   * que é o certo quando a contagem de itens varia; um número é para quando
   * a composição é a decisão — 2x2 se lê como quatro princípios, e a mesma
   * lista em três colunas se lê como três mais um órfão.
   */
  cols?: 'auto' | 2 | 3;
}

const {
  items,
  variant = 'card',
  min = '17rem',
  feature = false,
  cols = 'auto',
} = Astro.props;
---

<ul
  class:list={['grid', `v-${variant}`, { feature }, cols !== 'auto' && `c-${cols}`]}
  style={`--min:${min}`}
>
  {
    items.map((item) => (
      <li>
        {item.icon && <Icon name={item.icon} class="lead" />}
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </li>
    ))
  }
</ul>

<style>
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(min(var(--min), 100%), 1fr));
  }

  /* O ícone é apoio visual do título, não substituto: fica acima, no tom da
     marca do produto, e some da leitura de quem usa leitor de tela. */
  li :global(.lead) {
    --icon-size: 1.5rem;
    display: block;
    margin-bottom: var(--s-3);
    color: var(--color-primary);
  }

  h3 {
    font-size: var(--t-1);
    color: var(--color-text);
  }

  p {
    margin-top: var(--s-2);
    color: var(--color-muted);
    font-size: var(--t-0);
  }

  .v-card li {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--s-5);
  }

  .v-plain li {
    padding-top: var(--s-4);
    border-top: 2px solid var(--color-border);
  }

  @media (min-width: 48rem) {
    .c-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .c-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .feature {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .feature > li:first-child {
      grid-column: span 2;
    }

    /* No cartão em dobro, título e texto lado a lado. Dividir o parágrafo
       em duas colunas foi a primeira tentativa e ficou pior: um texto curto
       quebrado ao meio parece erro de renderização, não hierarquia. */
    .feature > li:first-child {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      gap: var(--s-6);
      align-items: start;
    }

    .feature > li:first-child h3 {
      font-size: var(--t-2);
      text-wrap: balance;
    }

    .feature > li:first-child p {
      margin-top: 0;
      font-size: var(--t-0);
    }

    /* O ícone acompanha o título na coluna da esquerda. */
    .feature > li:first-child :global(.lead) {
      grid-column: 1;
      --icon-size: 1.75rem;
    }

    .feature > li:first-child h3 {
      grid-column: 1;
      align-self: start;
    }

    .feature > li:first-child p {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }
</style>

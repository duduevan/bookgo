---
/** Grade de cartões título + texto: pilares do método, benefícios, materiais. */
import Icon from '../ui/Icon.astro';
import type { IconName } from '../../lib/icons';

interface Props {
  /** `icon` é opcional item a item: um cartão sem ícone continua válido. */
  items: Array<{ title: string; text: string; icon?: IconName }>;
  variant?: 'card' | 'plain';
  min?: string;
}

const { items, variant = 'card', min = '17rem' } = Astro.props;
---

<ul class:list={['grid', `v-${variant}`]} style={`--min:${min}`}>
  {
    items.map((item) => (
      <li>
        {item.icon && <Icon name={item.icon} class="lead" />}
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </li>
    ))
  }
</ul>

<style>
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(min(var(--min), 100%), 1fr));
  }

  /* O ícone é apoio visual do título, não substituto: fica acima, no tom da
     marca do produto, e some da leitura de quem usa leitor de tela. */
  li :global(.lead) {
    --icon-size: 1.5rem;
    display: block;
    margin-bottom: var(--s-3);
    color: var(--color-primary);
  }

  h3 {
    font-size: var(--t-1);
    color: var(--color-text);
  }

  p {
    margin-top: var(--s-2);
    color: var(--color-muted);
    font-size: var(--t-0);
  }

  .v-card li {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--s-5);
  }

  .v-plain li {
    padding-top: var(--s-4);
    border-top: 2px solid var(--color-border);
  }
</style>

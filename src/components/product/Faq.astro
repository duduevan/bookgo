---
/** FAQ com <details> nativo — acessível e sem JavaScript. */
import Icon from '../ui/Icon.astro';

interface Props {
  items: Array<{ q: string; a: string }>;
}

const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details>
        <summary>
          <span>{item.q}</span>
          <Icon name="chevron-down" />
        </summary>
        <p>{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    max-width: var(--w-text);
    border-top: 1px solid var(--color-border);
  }

  details {
    border-bottom: 1px solid var(--color-border);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-5);
    cursor: pointer;
    font-weight: 600;
    color: var(--color-text);
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--color-primary);
  }

  /* O <svg> vem de Icon.astro e não carrega o escopo deste componente:
     `:global` sob `summary`, que é escopado, é o que volta a alcançá-lo. */
  summary :global(.icon) {
    --icon-size: 1rem;
    color: var(--color-muted);
    transition: transform 0.15s ease;
  }

  details[open] summary :global(.icon) {
    transform: rotate(180deg);
  }

  details p {
    padding-bottom: var(--s-5);
    color: var(--color-muted);
    max-width: 68ch;
  }

  @media (prefers-reduced-motion: reduce) {
    summary :global(.icon) {
      transition: none;
    }
  }
</style>

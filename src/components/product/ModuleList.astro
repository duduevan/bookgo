---
/** Conteúdo do produto: módulos com número, título e objetivo. */
interface Props {
  modules: Array<{ number: number; title: string; objective: string }>;
}

const { modules } = Astro.props;
---

<ol class="modules">
  {
    modules.map((mod) => (
      <li>
        <p class="label">Módulo {mod.number}</p>
        <h3>{mod.title}</h3>
        <p class="objective">{mod.objective}</p>
      </li>
    ))
  }
</ol>

<style>
  .modules {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--c-line);
  }

  li {
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--c-line);
  }

  .label {
    font-size: var(--t--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-accent);
  }

  h3 {
    margin-top: var(--s-2);
    font-size: var(--t-2);
  }

  .objective {
    margin-top: var(--s-2);
    color: var(--c-ink-2);
    max-width: 62ch;
  }

  @media (min-width: 46rem) {
    li {
      display: grid;
      grid-template-columns: 9rem 1fr;
      column-gap: var(--s-5);
      row-gap: var(--s-2);
      align-items: baseline;
      padding-block: var(--s-6);
    }

    .label {
      grid-row: 1 / 3;
      padding-top: 0.4em;
    }

    h3 {
      margin-top: 0;
    }
  }
</style>

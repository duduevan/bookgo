---
/**
 * Seção de avaliações. Global, e de um produto só por vez.
 *
 * O componente **não conhece produto nenhum**: não sabe nomes, textos,
 * quantidade nem qual LP o está usando. Recebe uma lista e a renderiza. É
 * isso que permite a mesma peça servir o Casa Organizada, o Cardápio da
 * Semana e qualquer produto seguinte sem uma linha de código nova, e é
 * também o que impede a avaliação de um produto aparecer em outro: cada LP
 * passa o array do seu próprio YAML.
 *
 * Acrescentar uma avaliação é acrescentar um item no YAML do produto. Não
 * se edita componente, não se mexe em CSS, não se duplica HTML.
 *
 * A apresentação sai da quantidade, e não existe número máximo:
 *
 *   0 → nada renderizado, nem título, nem um byte de CSS
 *   1 → centrada, sem carrossel para navegar o que já está na tela
 *   2 → duas colunas de mesmo peso
 *  3+ → carrossel, aproximadamente 3 por vez no desktop, 2 no tablet,
 *       1 no celular
 *
 * O CSS e o script são emitidos daqui, **dentro** da guarda: é o que
 * garante custo zero para o produto que ainda não tem avaliação. Ver
 * src/styles/reviews.css.ts e src/scripts/reviews-carousel.ts.
 */
import Section from '../ui/Section.astro';
import ReviewCard from './ReviewCard.astro';
import ReviewConversation from './ReviewConversation.astro';
import { REVIEWS_CSS } from '../../styles/reviews.css';
import { REVIEWS_CAROUSEL_JS } from '../../scripts/reviews-carousel';
import { reviewsLayout } from '../../lib/reviews';

interface CardItem {
  type: 'card';
  name?: string;
  role?: string;
  date?: string;
  rating?: number;
  avatar?: string;
  text: string;
}

interface ConversationItem {
  type: 'phone';
  name?: string;
  avatar?: string;
  status?: string;
  messages: Array<{
    side: 'incoming' | 'outgoing';
    text: string;
    time?: string;
    read?: boolean;
  }>;
}

type Item = CardItem | ConversationItem;

interface Props {
  enabled: boolean;
  /**
   * Conteúdo de demonstração: renderiza um rótulo **visível** dizendo que
   * aquilo é exemplo de layout.
   *
   * O rótulo é deliberado e não deve ser escondido. Um aviso que mora só no
   * código deixa de existir exatamente quando mais importa, na hora em que
   * alguém publica sem lembrar. Assim, publicar por engano fica óbvio na
   * própria página.
   */
  demo?: boolean;
  /**
   * `depoimento` traz pessoa real e autorizada. `demonstracao` traz as
   * dúvidas que aparecem antes de começar, respondidas pela BookGo: mesmo
   * desenho, sem ninguém a nomear e sem afirmar resultado de ninguém.
   */
  kind?: 'depoimento' | 'demonstracao';
  title?: string;
  subtitle?: string;
  items: Item[];
  tone?: 'default' | 'warm' | 'soft';
}

const {
  enabled,
  demo = false,
  kind = 'depoimento',
  title,
  subtitle,
  items,
  tone = 'warm',
} = Astro.props;

const layout = reviewsLayout(enabled, items.length);
const isCarousel = layout === 'carousel';

/* Numa demonstração o cabeçalho da conversa é a própria BookGo, que é quem
   responde. Inventar um nome ali transformaria a explicação do método em
   depoimento de uma pessoa que não existe. */
const headerName = (item: Item) =>
  kind === 'demonstracao' ? 'BookGo' : (item.name ?? '');

/* Conversas são estreitas por natureza e não esticam para preencher a
   faixa. Vale para uma e para duas; no carrossel a largura do trilho já
   manda. */
const onlyConversations = items.every((i) => i.type === 'phone');

/* Rótulo da região rolável. Sem ele, quem navega por teclado encontra uma
   caixa focável sem nome. */
const trackLabel = title ?? 'Avaliações';
---

{
  layout !== 'none' && (
    <Section tone={tone} title={title} intro={subtitle} align="center">
      <style is:inline set:html={REVIEWS_CSS} />

      {/* Identificação discreta, no lugar de uma tarja de alerta.
          Continua visível na página, que é o ponto. O rótulo só existe no
          modo depoimento, para conteúdo de exemplo: em `demonstracao` a
          seção não afirma que alguém disse aquilo, então não há o que
          ressalvar. */}
      {demo && kind === 'depoimento' && (
        <p class="rv-ilustrativa">Conversas ilustrativas</p>
      )}

      <div class="rv-wrap" data-rv-carousel={isCarousel ? '' : undefined}>
        <div
          class:list={[
            isCarousel ? 'rv-track' : `rv-${layout}`,
            { 'rv-conversas': onlyConversations && !isCarousel },
          ]}
          role={isCarousel ? 'group' : undefined}
          aria-roledescription={isCarousel ? 'carrossel' : undefined}
          aria-label={isCarousel ? trackLabel : undefined}
          tabindex={isCarousel ? '0' : undefined}
        >
          {items.map((item) =>
            item.type === 'phone' ? (
              <ReviewConversation
                name={headerName(item)}
                avatar={item.avatar}
                status={item.status}
                messages={item.messages}
              />
            ) : (
              <ReviewCard
                name={headerName(item)}
                role={item.role}
                date={item.date}
                rating={item.rating}
                avatar={item.avatar}
                text={item.text}
              />
            )
          )}
        </div>

        {/* Controles. Nascem escondidos: sem JavaScript eles não fariam
            nada, e a barra de rolagem já diz que há mais ao lado. O script
            os revela e, quando tudo cabe na tela, volta a escondê-los em
            vez de deixar setas mortas na página. */}
        {isCarousel && (
          <div class="rv-nav" hidden>
            <button
              class="rv-arrow"
              type="button"
              data-rv-prev
              aria-label="Ver as avaliações anteriores"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M20 12H6" />
                <path d="M11.5 6.5 6 12l5.5 5.5" />
              </svg>
            </button>

            <ul class="rv-dots">
              {items.map((_, i) => (
                <li>
                  <button
                    class="rv-dot"
                    type="button"
                    data-rv-dot
                    aria-current={i === 0 ? 'true' : 'false'}
                    aria-label={`Ir para a avaliação ${i + 1} de ${items.length}`}
                  />
                </li>
              ))}
            </ul>

            <button
              class="rv-arrow"
              type="button"
              data-rv-next
              aria-label="Ver as próximas avaliações"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M4 12h14" />
                <path d="M12.5 6.5 18 12l-5.5 5.5" />
              </svg>
            </button>
          </div>
        )}
      </div>

      {isCarousel && <script is:inline set:html={REVIEWS_CAROUSEL_JS} />}
    </Section>
  )
}

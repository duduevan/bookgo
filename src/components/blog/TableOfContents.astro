---
/**
 * Índice do artigo, montado a partir dos headings devolvidos pelo render
 * do MDX. Âncoras HTML reais, sem JavaScript de scroll.
 *
 * H2 é a espinha do índice. H3 entra apenas quando a seção realmente se
 * divide — um H3 sozinho sob um H2 não ajuda ninguém, então é descartado.
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  title?: string;
}

const { headings, title = 'Neste artigo' } = Astro.props;

const items = headings.filter((h) => h.depth === 2 || h.depth === 3);

const tree = items
  .filter((h) => h.depth === 2)
  .map((h2) => {
    const start = items.indexOf(h2);
    const children: MarkdownHeading[] = [];
    for (let i = start + 1; i < items.length; i++) {
      if (items[i]!.depth === 2) break;
      children.push(items[i]!);
    }
    return { ...h2, children: children.length > 1 ? children : [] };
  });
---

{
  tree.length > 1 && (
    <nav class="toc" aria-labelledby="indice-artigo">
      <h2 id="indice-artigo">{title}</h2>
      <ol>
        {tree.map((h2) => (
          <li>
            <a href={`#${h2.slug}`}>{h2.text}</a>
            {h2.children.length > 0 && (
              <ul>
                {h2.children.map((h3) => (
                  <li>
                    <a href={`#${h3.slug}`}>{h3.text}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    max-width: var(--w-prose);
    padding-block: var(--s-5);
    border-block: 1px solid var(--color-border);
  }

  h2 {
    font-size: var(--t--1);
    font-weight: var(--w-semibold);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 var(--s-4);
  }

  ol,
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  ul {
    margin-top: var(--s-2);
    padding-left: var(--s-5);
    border-left: 1px solid var(--color-border);
  }

  a {
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--t-0);
    line-height: 1.45;
  }

  a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  ul a {
    color: var(--color-muted);
    font-size: var(--t--1);
  }

  /* Mobile: mesma informação, menos altura. */
  @media (max-width: 46rem) {
    ol {
      gap: var(--s-3);
    }

    ul {
      display: none;
    }
  }
</style>

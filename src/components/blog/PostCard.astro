---
import Icon from '../ui/Icon.astro';
import { formatDate, postUrl, type Post } from '../../lib/content';

interface Props {
  post: Post;
  categoryName?: string;
  /** Destaque: ocupa mais espaço na grade e usa tipografia maior. */
  featured?: boolean;
}

const { post, categoryName, featured = false } = Astro.props;
const href = postUrl(post);
---

<article class:list={['card', { featured }]}>
  <p class="meta">
    {categoryName && <span class="cat">{categoryName}</span>}
    <time datetime={post.data.date.toISOString()}>
      {formatDate(post.data.date)}
    </time>
  </p>

  <h3>
    {/* O link cobre o card inteiro, mantendo um só alvo de foco. */}
    <a href={href}>
      <span class="overlay"></span>
      {post.data.title}
    </a>
  </h3>

  <p class="desc">{post.data.description}</p>

  <span class="more" aria-hidden="true">
    Ler artigo
    <Icon name="arrow-right" />
  </span>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--color-primary) 32%, var(--color-border));
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--t--1);
    color: var(--color-muted);
  }

  .cat {
    color: var(--color-primary);
    font-weight: var(--w-semibold);
  }

  h3 {
    margin-top: var(--s-4);
    font-size: var(--t-2);
  }

  .featured h3 {
    font-size: var(--t-3);
  }

  h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .overlay {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .desc {
    margin-top: var(--s-3);
    color: var(--color-muted);
    max-width: 60ch;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-6);
    padding-top: var(--s-5);
    border-top: 1px solid var(--color-border);
    font-size: var(--t--1);
    font-weight: var(--w-semibold);
    color: var(--color-primary);
  }

  .more :global(.icon) {
    --icon-size: 1rem;
    transition: transform var(--dur) var(--ease);
  }

  .card:hover .more :global(.icon) {
    transform: translateX(3px);
  }

  /* Empurra o rodapé do card para baixo, alinhando cards de alturas
     diferentes na mesma linha da grade. */
  .desc {
    flex: 1;
  }
</style>

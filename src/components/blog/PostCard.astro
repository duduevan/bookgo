---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { formatDate, postUrl, type Post } from '../../lib/content';
import { resolveArticleImages } from '../../lib/article-images';

interface Props {
  post: Post;
  categoryName?: string;
  /** Destaque: ocupa mais espaço na grade e usa tipografia maior. */
  featured?: boolean;
  /**
   * Mostra a primeira imagem editorial do artigo como miniatura.
   *
   * Só onde a miniatura ajuda a escolher o que ler — o hub da categoria.
   * Na lista dentro da própria LP ela competiria com a oferta.
   *
   * O `alt` fica vazio de propósito: o título do artigo está ao lado e é o
   * nome acessível do link. Repetir a descrição da cena faria o leitor de
   * tela anunciar a mesma entrada duas vezes.
   */
  thumbnail?: boolean;
}

const { post, categoryName, featured = false, thumbnail = false } = Astro.props;
const href = postUrl(post);

/* Sem arquivo, não há miniatura e o cartão volta ao formato de texto —
   nenhuma moldura vazia. */
const thumb = thumbnail
  ? resolveArticleImages(post).find((i) => i.image)?.image
  : undefined;
---

<article class:list={['card', { featured, 'has-thumb': thumb }]}>
  {
    thumb && (
      <div class="thumb">
        <Image
          src={thumb}
          alt=""
          widths={[320, 480, 720]}
          sizes="(min-width: 60rem) 22rem, calc(100vw - 2 * var(--gutter))"
          loading="lazy"
          decoding="async"
          quality={70}
        />
      </div>
    )
  }
  <p class="meta">
    {categoryName && <span class="cat">{categoryName}</span>}
    <time datetime={post.data.date.toISOString()}>
      {formatDate(post.data.date)}
    </time>
  </p>

  <h3>
    {/* O link cobre o card inteiro, mantendo um só alvo de foco. */}
    <a href={href}>
      <span class="overlay"></span>
      {post.data.title}
    </a>
  </h3>

  <p class="desc">{post.data.description}</p>

  <span class="more" aria-hidden="true">
    Ler artigo
    <Icon name="arrow-right" />
  </span>
</article>

<style>
  /* Cartão de destaque com miniatura: imagem ao lado do texto, não acima.
     Empilhada, a chamada principal empurrava o título para fora da dobra. */
  @media (min-width: 60rem) {
    .featured.has-thumb {
      display: grid;
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
      gap: var(--s-7);
      align-items: center;
    }

    .featured.has-thumb .thumb {
      margin-bottom: 0;
      height: 100%;
    }
  }

  /* Sem miniatura, o texto do destaque não estica pela largura inteira. */
  .featured .desc {
    max-width: 62ch;
  }

  .thumb {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: var(--s-5);
    background: var(--color-surface);
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--dur) var(--ease);
  }

  .card:hover .thumb :global(img) {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb :global(img) {
      transition: none;
    }

    .card:hover .thumb :global(img) {
      transform: none;
    }
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-raised);
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--color-primary) 32%, var(--color-border));
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--t--1);
    color: var(--color-muted);
  }

  .cat {
    color: var(--color-primary);
    font-weight: var(--w-semibold);
  }

  h3 {
    margin-top: var(--s-4);
    font-size: var(--t-2);
  }

  .featured h3 {
    font-size: var(--t-3);
  }

  h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .overlay {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .desc {
    margin-top: var(--s-3);
    color: var(--color-muted);
    max-width: 60ch;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-6);
    padding-top: var(--s-5);
    border-top: 1px solid var(--color-border);
    font-size: var(--t--1);
    font-weight: var(--w-semibold);
    color: var(--color-primary);
  }

  .more :global(.icon) {
    --icon-size: 1rem;
    transition: transform var(--dur) var(--ease);
  }

  .card:hover .more :global(.icon) {
    transform: translateX(3px);
  }

  /* Empurra o rodapé do card para baixo, alinhando cards de alturas
     diferentes na mesma linha da grade. */
  .desc {
    flex: 1;
  }
</style>

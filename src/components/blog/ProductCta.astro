---
/**
 * CTA contextual exibido no artigo quando o frontmatter define `product`.
 * Toda a copy vem do produto — nada é escrito aqui.
 */
import Cta from '../ui/Cta.astro';
import { hasCheckout, productUrl, type Product } from '../../lib/content';
import { eventAttrs } from '../../lib/tracking';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { name, tagline, price, checkout } = product.data;
const href = productUrl(product.data.slug);

const checkoutEvent = eventAttrs('checkout_click', {
  product_slug: product.data.slug,
  product_name: name,
  value: price.amount,
  currency: price.currency,
  placement: 'article_cta',
});
---

<aside class="promo" aria-label="Produto relacionado">
  <p class="eyebrow">Material relacionado</p>
  <h2><a href={href}>{name}</a></h2>
  <p class="tagline">{tagline}</p>
  <div class="actions">
    <Cta
      href={hasCheckout(product) ? checkout.url : null}
      label={checkout.cta}
      track={checkoutEvent}
    />
    <a class="details" href={href}>Ver detalhes — {price.display}</a>
  </div>
</aside>

<style>
  .promo {
    margin-top: var(--s-9);
    padding: var(--s-6);
    background: var(--color-primary-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    max-width: var(--w-prose);
  }

  h2 {
    margin-top: var(--s-2);
    font-size: var(--t-2);
  }

  h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--color-primary);
  }

  .tagline {
    margin-top: var(--s-3);
    color: var(--color-muted);
    font-size: var(--t-0);
  }

  .actions {
    margin-top: var(--s-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-5);
  }

  .details {
    font-size: var(--t--1);
    color: var(--color-primary);
  }
</style>
